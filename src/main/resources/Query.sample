-- ==============================================================================
-- 4. APPLICATION QUERIES REFERENCE (RENESPRESSO DAOs)
-- ==============================================================================

-- ------------------------------------------------------------------------------
-- 4.1 USER & AUTHENTICATION QUERIES (UserDAO, DatabaseSeeder)
-- ------------------------------------------------------------------------------

-- Authenticate User Login
-- Source: UserDAO.authenticate(username, plainPassword)
SELECT user_id, username, password, full_name, role, is_active 
FROM users 
WHERE LOWER(username) = LOWER(?) AND is_active = 1;

-- Update Last Login Timestamp
-- Source: UserDAO.touchLastLogin(userId)
UPDATE users SET last_login = NOW() WHERE user_id = ?;

-- Admin/Manager Elevation Authorization Modal
-- Source: UserDAO.validateAdminCredentials(username, plainPassword)
SELECT password, role FROM users 
WHERE username = ? AND role IN ('ADMIN', 'MANAGER') AND is_active = 1;

-- Register New User Account
-- Source: UserDAO.registerUser(user, plainPassword)
INSERT INTO users (username, password, full_name, role, is_active) 
VALUES (?, ?, ?, ?, ?);

-- List All Accounts for User Management Table
-- Source: UserDAO.getAllAccounts()
SELECT user_id, full_name, username, role, is_active, last_login, created_at 
FROM users 
ORDER BY created_at DESC;

-- Validate Duplicate Username (Excluding Current User ID)
-- Source: UserDAO.usernameExists(username, excludeId)
SELECT 1 FROM users 
WHERE LOWER(username) = LOWER(?) AND user_id <> ?;

-- Count Remaining Active Admins (Prevent Self-Lockout)
-- Source: UserDAO.countOtherActiveAdmins(excludeId)
SELECT COUNT(*) FROM users 
WHERE role = 'ADMIN' AND is_active = 1 AND user_id <> ?;

-- Update Account Information (With or Without Password Hash)
-- Source: UserDAO.updateAccount(id, fullName, username, role, active, newPlainPassword)
UPDATE users 
SET full_name = ?, username = ?, role = ?, is_active = ? [, password = ?] 
WHERE user_id = ?;

-- Delete Account
-- Source: UserDAO.deleteAccount(id)
DELETE FROM users WHERE user_id = ?;

-- Check User Existence for Seeder
-- Source: DatabaseSeeder.seedAccountIfNotExists(username, plainPassword, fullName, role)
SELECT COUNT(*) FROM users WHERE username = ?;


-- ------------------------------------------------------------------------------
-- 4.2 MENU & INVENTORY MANAGEMENT QUERIES (MenuDAO, ProductVariantDAO)
-- ------------------------------------------------------------------------------

-- Get All Active Categories Ordered by Custom Sort
-- Source: MenuDAO.getCategories()
SELECT category_id, name 
FROM categories 
ORDER BY sort_order, name;

-- Add New Category with Auto-Incremented Sort Order
-- Source: MenuDAO.addCategory(name)
INSERT INTO categories (name, sort_order) 
VALUES (?, (SELECT COALESCE(MAX(sort_order), 0) + 1 FROM (SELECT sort_order FROM categories) t));

-- Delete Category
-- Source: MenuDAO.deleteCategory(id)
DELETE FROM categories WHERE category_id = ?;

-- Get All Products with Category and Minimum Variant Starting Price
-- Source: MenuDAO.getProducts()
SELECT p.id, p.name, p.category_id, c.name AS category, 
       (SELECT COALESCE(MIN(price), 0) FROM product_variants WHERE product_id = p.id) AS price, 
       p.description, p.image_path, p.available, p.quantity 
FROM products p 
JOIN categories c ON c.category_id = p.category_id 
ORDER BY c.sort_order, p.name;

-- Add New Product
-- Source: MenuDAO.addProduct(name, categoryId, description, imagePath, available, quantity)
INSERT INTO products (name, category_id, description, image_path, available, quantity) 
VALUES (?, ?, ?, ?, ?, ?);

-- Update Product Details and Stock Quantity
-- Source: MenuDAO.updateProduct(id, name, categoryId, description, imagePath, available, quantity)
UPDATE products 
SET name = ?, category_id = ?, description = ?, image_path = ?, available = ?, quantity = ? 
WHERE id = ?;

-- Quick-Toggle Product Availability Switch
-- Source: MenuDAO.setAvailable(id, available)
UPDATE products SET available = ? WHERE id = ?;

-- Delete Product
-- Source: MenuDAO.deleteProduct(id)
DELETE FROM products WHERE id = ?;

-- Get All Variants Across All Products
-- Source: MenuDAO.getAllVariants()
SELECT variant_id, product_id, size_name, price 
FROM product_variants 
ORDER BY price ASC;

-- Get Product Variants for a Specific Product ID
-- Source: ProductVariantDAO.getVariantsByProductId(productId)
SELECT variant_id, product_id, size_name, price 
FROM product_variants 
WHERE product_id = ? 
ORDER BY price ASC;

-- Add Product Variant (Size & Price)
-- Source: ProductVariantDAO.addVariant(productId, sizeName, price)
INSERT INTO product_variants (product_id, size_name, price) 
VALUES (?, ?, ?);

-- Update Product Variant Size or Price
-- Source: ProductVariantDAO.updateVariant(variantId, sizeName, price)
UPDATE product_variants 
SET size_name = ?, price = ? 
WHERE variant_id = ?;

-- Delete Product Variant
-- Source: ProductVariantDAO.deleteVariant(variantId)
DELETE FROM product_variants WHERE variant_id = ?;


-- ------------------------------------------------------------------------------
-- 4.3 TRANSACTION & POS CHECKOUT QUERIES (TransactionDAO)
-- ------------------------------------------------------------------------------

-- Save Transaction Header Record (Inside DB Transaction)
-- Source: TransactionDAO.saveTransaction(...)
INSERT INTO transactions (
    cashier_id, order_id, ticket_number, total_amount, subtotal, vat,
    discount, tendered, payment_method, payment_status, status, receipt_text, created_at, updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Insert or Accumulate Transaction Line Items (Batch execution)
-- Source: TransactionDAO.saveTransaction(...)
INSERT INTO transaction_items (transaction_id, variant_id, quantity, price)
VALUES (?, ?, ?, ?)
ON DUPLICATE KEY UPDATE quantity = quantity + VALUES(quantity);

-- Update Formatted Order ID (e.g. TXN-84xx)
-- Source: TransactionDAO.saveTransaction(...)
UPDATE transactions SET order_id = ? WHERE transaction_id = ?;

-- Update Order Status (PREPARING -> COMPLETED or CANCELLED)
-- Source: TransactionDAO.updateStatus(transactionId, status)
UPDATE transactions 
SET status = ?, updated_at = CURRENT_TIMESTAMP 
WHERE transaction_id = ?;

-- Load All Transactions with Cashier Information (Admin Sales View)
-- Source: TransactionDAO.loadAllTransactions()
SELECT t.*, u.full_name AS staff_name, u.role AS staff_role 
FROM transactions t 
LEFT JOIN users u ON u.user_id = t.cashier_id 
ORDER BY t.created_at DESC;

-- Load Today's Transactions for Active Cashier
-- Source: TransactionDAO.loadTodayTransactions()
SELECT t.*, u.full_name AS staff_name, u.role AS staff_role 
FROM transactions t 
LEFT JOIN users u ON u.user_id = t.cashier_id 
WHERE DATE(t.created_at) = CURDATE() 
ORDER BY t.created_at DESC;

-- Load Line Items for an Order with Product and Variant Info
-- Source: TransactionDAO.loadTransactionLines(conn, txId)
SELECT ti.quantity, ti.price, p.name AS product_name, pv.size_name
FROM transaction_items ti
JOIN product_variants pv ON pv.variant_id = ti.variant_id
JOIN products p ON p.id = pv.product_id
WHERE ti.transaction_id = ?;


-- ------------------------------------------------------------------------------
-- 4.4 REPORTING, DASHBOARD & ANALYTICS QUERIES (TransactionDAO, HomeDAO)
-- ------------------------------------------------------------------------------

-- Sales Aggregates Summary: Today, This Week, and This Month
-- Source: TransactionDAO.getSalesSummary()
SELECT 
    COALESCE(SUM(CASE WHEN DATE(created_at) = CURDATE() THEN total_amount ELSE 0 END), 0) AS today_sales,
    COUNT(CASE WHEN DATE(created_at) = CURDATE() THEN 1 END) AS today_orders,
    COALESCE(SUM(CASE WHEN YEARWEEK(created_at, 1) = YEARWEEK(CURDATE(), 1) THEN total_amount ELSE 0 END), 0) AS week_sales,
    COUNT(CASE WHEN YEARWEEK(created_at, 1) = YEARWEEK(CURDATE(), 1) THEN 1 END) AS week_orders,
    COALESCE(SUM(CASE WHEN YEAR(created_at) = YEAR(CURDATE()) AND MONTH(created_at) = MONTH(CURDATE()) THEN total_amount ELSE 0 END), 0) AS month_sales,
    COUNT(CASE WHEN YEAR(created_at) = YEAR(CURDATE()) AND MONTH(created_at) = MONTH(CURDATE()) THEN 1 END) AS month_orders
FROM transactions
WHERE status != 'CANCELLED';

-- Last 14 Days Sales Trend for Charts
-- Source: TransactionDAO.getLast14DaysSales()
SELECT DATE_FORMAT(d.dt, '%b %d') AS lbl, COALESCE(SUM(t.total_amount), 0) AS total
FROM (
    SELECT CURDATE() - INTERVAL (a.a + (10 * b.a)) DAY AS dt
    FROM (SELECT 0 AS a UNION ALL SELECT 1 UNION ALL SELECT 2 UNION ALL SELECT 3 
          UNION ALL SELECT 4 UNION ALL SELECT 5 UNION ALL SELECT 6 UNION ALL SELECT 7 
          UNION ALL SELECT 8 UNION ALL SELECT 9) AS a
    CROSS JOIN (SELECT 0 AS a UNION ALL SELECT 1) AS b
    WHERE (a.a + (10 * b.a)) < 14
) d
LEFT JOIN transactions t ON DATE(t.created_at) = d.dt AND t.status != 'CANCELLED'
GROUP BY d.dt, lbl
ORDER BY d.dt ASC;

-- Dashboard Sales Total and Order Count for Specific Date Range
-- Source: HomeDAO.totals(conn, fromDate, toDate)
SELECT COALESCE(SUM(total_amount), 0), COUNT(*) 
FROM transactions 
WHERE status != 'CANCELLED' AND created_at >= ? AND created_at < ?;

-- Dashboard Quantity of Items Sold in Date Range
-- Source: HomeDAO.itemsSold(conn, fromDate, toDate)
SELECT COALESCE(SUM(ti.quantity), 0) 
FROM transaction_items ti 
JOIN transactions t ON t.transaction_id = ti.transaction_id 
WHERE t.status != 'CANCELLED' AND t.created_at >= ? AND t.created_at < ?;

-- Dashboard 7-Day Revenue Trend Grouped by Date
-- Source: HomeDAO.last7Days(conn, today)
SELECT DATE(created_at) AS d, SUM(total_amount) AS s 
FROM transactions 
WHERE status != 'CANCELLED' AND created_at >= ? AND created_at < ? 
GROUP BY DATE(created_at);

-- Top 5 Best Selling Products by Volume and Revenue
-- Source: HomeDAO.topProducts(conn, fromDate, toDate)
SELECT p.name, SUM(ti.quantity) AS qty, SUM(ti.quantity * ti.price) AS revenue 
FROM transaction_items ti 
JOIN transactions t ON t.transaction_id = ti.transaction_id 
JOIN product_variants pv ON pv.variant_id = ti.variant_id 
JOIN products p ON p.id = pv.product_id 
WHERE t.status != 'CANCELLED' AND t.created_at >= ? AND t.created_at < ? 
GROUP BY p.id, p.name 
ORDER BY qty DESC 
LIMIT 5;

-- Recent Orders Activity Feed (Admin Home Dashboard)
-- Source: HomeDAO.recentOrders(conn)
SELECT t.transaction_id, COALESCE(u.full_name, '-') AS cashier, 
       t.total_amount, t.status, t.created_at 
FROM transactions t 
LEFT JOIN users u ON u.user_id = t.cashier_id 
ORDER BY t.created_at DESC 
LIMIT 8;

-- Staff Active & Total Count Grouped by Role
-- Source: HomeDAO.loadStaff()
SELECT role, COUNT(*) AS total, COALESCE(SUM(is_active), 0) AS active 
FROM users 
GROUP BY role 
ORDER BY FIELD(role, 'ADMIN', 'MANAGER', 'CASHIER');


-- ------------------------------------------------------------------------------
-- 4.5 DATABASE EXPORT & BACKUP QUERIES (ExcelBackupUtil)
-- ------------------------------------------------------------------------------

-- Export Full Table Data to Individual Excel Sheets
-- Source: ExcelBackupUtil.backupToExcel(conn, outFile)
SELECT * FROM `categories`;
SELECT * FROM `products`;
SELECT * FROM `product_variants`;
SELECT * FROM `users`;
SELECT * FROM `transactions`;
SELECT * FROM `transaction_items`;