<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Font?>

<HBox prefHeight="550.0" prefWidth="850.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.coffeepos.renespresso.controller.ForgotPasswordController">
    <children>
        <!-- Left Branding Panel -->
        <VBox alignment="CENTER" prefWidth="320.0" spacing="12.0" style="-fx-background-color: #f5e6ca;" HBox.hgrow="NEVER">
            <padding>
                <Insets bottom="40.0" left="30.0" right="30.0" top="40.0" />
            </padding>
            <children>
                <!-- Coffee Cup Vector Icon -->
                <SVGPath content="M 8 0 C 6.89 0 6 0.89 6 2 C 6 3.11 6.89 4 8 4 C 8.55 4 9 4.45 9 5 C 9 5.55 8.55 6 8 6 C 5.79 6 4 7.79 4 10 L 4 20 C 4 23.31 6.69 26 10 26 L 18 26 C 21.31 26 24 23.31 24 20 L 24 10 C 24 7.79 22.21 6 20 6 C 19.45 6 19 5.55 19 5 C 19 4.45 19.45 4 20 4 C 21.11 4 22 3.11 22 2 C 22 0.89 21.11 0 20 0 Z M 14 0 C 12.89 0 12 0.89 12 2 C 12 3.11 12.89 4 14 4 C 14.55 4 15 5.55 14.55 6 14 6 C 13.45 6 13 6.45 13 7 C 13 7.55 13.45 8 14 8 Z M 24 10 L 26 10 C 28.21 10 30 11.79 30 14 L 30 16 C 30 18.21 28.21 20 26 20 L 24 20 Z" fill="#6f4e37" scaleX="1.8" scaleY="1.8" />

                <Region prefHeight="10.0" />

                <Label text="Renespresso" textFill="#6f4e37">
                    <font>
                        <Font name="System Bold" size="28.0" />
                    </font>
                </Label>

                <Label style="-fx-letter-spacing: 1.5px;" text="COFFEE SHOP POS" textFill="#6f4e37">
                    <font>
                        <Font name="System Bold" size="11.0" />
                    </font>
                </Label>

                <Region prefHeight="15.0" />

                <Label text="Quick, secure, and brewed&#10;to perfection." textAlignment="CENTER" textFill="#6f4e37">
                    <font>
                        <Font name="System Italic" size="13.0" />
                    </font>
                </Label>
            </children>
        </VBox>

        <!-- Right Main Content Panel -->
        <VBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #fffdf7;" HBox.hgrow="ALWAYS">
            <padding>
                <Insets bottom="50.0" left="60.0" right="60.0" top="50.0" />
            </padding>
            <children>
                <!-- Header Text Block -->
                <VBox spacing="8.0">
                    <children>
                        <Label text="Forgot Password?" textFill="#6f4e37">
                            <font>
                                <Font name="System Bold" size="30.0" />
                            </font>
                        </Label>
                        <Label text="Enter your registered email address below. We'll send you instructions to reset your password." textFill="#6f4e37" wrapText="true">
                            <font>
                                <Font size="13.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <Region prefHeight="10.0" />

                <!-- Input Form Block -->
                <VBox spacing="6.0">
                    <children>
                        <Label style="-fx-letter-spacing: 0.5px;" text="EMAIL ADDRESS" textFill="#6f4e37">
                            <font>
                                <Font name="System Bold" size="11.0" />
                            </font>
                        </Label>
                        <TextField fx:id="emailField" prefHeight="45.0" promptText="barista@renespresso.com" style="-fx-background-color: #fffdf7; -fx-border-color: #dcc7aa; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 0 12; -fx-prompt-text-fill: #dcc7aa; -fx-text-inner-color: #6f4e37;">
                            <font>
                                <Font size="13.0" />
                            </font>
                        </TextField>
                    </children>
                </VBox>

                <!-- Submit Button -->
                <Button fx:id="sendResetButton" maxWidth="1.7976931348623157E308" onAction="#handleSendResetLink" prefHeight="48.0" text="Send Reset Link" textFill="#fffdf7">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                    <style>
                        -fx-background-color: #6f4e37;
                        -fx-background-radius: 8;
                        -fx-cursor: hand;
                    </style>
                </Button>

                <!-- Back to Login Navigation -->
                <HBox alignment="CENTER" spacing="4.0">
                    <children>
                        <Label text="Remember your password?" textFill="#6f4e37">
                            <font>
                                <Font size="13.0" />
                            </font>
                        </Label>
                        <Hyperlink fx:id="backToLoginLink" onAction="#handleBackToLogin" style="-fx-underline: false; -fx-font-weight: bold;" text="Back to Login" textFill="#6f4e37">
                            <font>
                                <Font size="13.0" />
                            </font>
                        </Hyperlink>
                    </children>
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </HBox>
            </children>
        </VBox>
    </children>
</HBox>