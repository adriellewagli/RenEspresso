<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Place at: views/main/user/transact/TransactionHistoryView.fxml
     Styling comes from the existing user-dashboard.css (already loaded by the cashier shell). -->
<VBox spacing="18.0" styleClass="tx-container"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.coffeepos.renespresso.controller.main.user.transact.TransactionHistoryController">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
            <Label styleClass="tx-title" text="Transaction History" />
            <Label styleClass="tx-subtitle" text="Review the orders and payments you have processed" />
        </VBox>
        <Label fx:id="lblSummary" styleClass="tx-summary" text="" />
    </HBox>

    <!-- Filters -->
    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="filter-card">
        <TextField fx:id="txtSearch" prefWidth="320.0" promptText="Search order ID, item or status..." styleClass="tx-search" />
        <Region HBox.hgrow="ALWAYS" />
        <ComboBox fx:id="cmbDateFilter" prefWidth="170.0" />
        <ComboBox fx:id="cmbStatusFilter" prefWidth="180.0" />
        <ComboBox fx:id="cmbPaymentFilter" prefWidth="160.0" />
        <Button fx:id="btnClearFilters" onAction="#handleClearFilters" styleClass="btn-clear" text="Clear Filters" />
    </HBox>

    <!-- Table + pager -->
    <VBox styleClass="table-card" VBox.vgrow="ALWAYS">
        <TableView fx:id="tblTransactions" styleClass="tx-table" VBox.vgrow="ALWAYS">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colOrderId" prefWidth="140.0" text="ORDER ID" />
                <TableColumn fx:id="colCreated" prefWidth="210.0" text="CREATED / LAST EDIT" />
                <TableColumn fx:id="colItems" prefWidth="100.0" text="ITEMS" />
                <TableColumn fx:id="colTotal" prefWidth="130.0" text="TOTAL" />
                <TableColumn fx:id="colStatus" prefWidth="150.0" sortable="false" text="STATUS" />
                <TableColumn fx:id="colPayment" prefWidth="120.0" sortable="false" text="PAYMENT" />
                <TableColumn fx:id="colActions" prefWidth="150.0" sortable="false" text="ACTIONS" />
            </columns>
        </TableView>
        <HBox fx:id="pagerBox" alignment="CENTER" />
    </VBox>
</VBox>
