<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fx:id="settingsRoot" spacing="20.0" styleClass="settings-root"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.coffeepos.renespresso.controller.main.admin.settings.SettingsController">

    <VBox spacing="4.0" styleClass="page-header">
        <Label styleClass="settings-title" text="Settings" />
        <Label styleClass="settings-subtitle" text="Application preferences and configuration" />
    </VBox>

    <!-- BACKUP DATABASE CARD -->
    <VBox maxWidth="640.0" spacing="10.0" styleClass="card, settings-card">
        <Label styleClass="card-title" text="Backup Database" />
        <Label styleClass="card-desc" wrapText="true"
               text="Export all store data (menu, transactions, accounts) so you can keep a safe copy." />

        <Separator style="-fx-opacity: 0.3;" />

        <HBox alignment="CENTER_LEFT" spacing="14.0">
            <Button fx:id="btnBackupExcel" onAction="#handleBackupExcel"
                    styleClass="primary-button" text="📊  Backup Database into Excel" />
            <ProgressIndicator fx:id="progress" managed="false" prefHeight="24.0" prefWidth="24.0" visible="false" />
        </HBox>

        <Label fx:id="lblStatus" styleClass="status-text" wrapText="true" />
    </VBox>
</VBox>