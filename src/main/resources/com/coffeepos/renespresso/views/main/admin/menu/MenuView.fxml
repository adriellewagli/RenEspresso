<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fx:id="root" spacing="16.0" styleClass="menu-container"
      stylesheets="@../../../styles/admin/menu/menu.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.coffeepos.renespresso.controller.main.admin.menu.MenuController">

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
            <Label styleClass="menu-title" text="Menu Management" />
            <Label styleClass="menu-subtitle" text="Add, edit and organize drinks and food items" />
        </VBox>
        <Button fx:id="addDishBtn" onAction="#handleAddDish" styleClass="add-dish-button" text="+  Add New Dish" />
    </HBox>

    <!-- SEARCH + FILTERS -->
    <VBox spacing="12.0" styleClass="card, toolbar-card">
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="search-box" HBox.hgrow="ALWAYS">
                <Region styleClass="icon-search" />
                <TextField fx:id="searchField" promptText="Search dishes or categories…"
                           styleClass="search-field" HBox.hgrow="ALWAYS" />
            </HBox>
            <ComboBox fx:id="availabilityFilter" styleClass="filter-combo" />
        </HBox>
        <FlowPane fx:id="categoryChips" hgap="8.0" vgap="8.0" />
    </VBox>

    <Label fx:id="countLabel" styleClass="count-label" />

    <!-- DISH GRID -->
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="menu-scroll" VBox.vgrow="ALWAYS">
        <content>
            <FlowPane fx:id="dishGrid" hgap="18.0" vgap="22.0" styleClass="dish-grid" />
        </content>
    </ScrollPane>
</VBox>