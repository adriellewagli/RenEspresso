<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefWidth="920.0" prefHeight="580.0" spacing="16.0" styleClass="account-dialog, modal-container"
      stylesheets="@../../../styles/admin/account/account.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.coffeepos.renespresso.controller.main.admin.account.ArchivedAccountsModalController">

    <padding>
        <Insets top="26.0" right="30.0" bottom="24.0" left="30.0" />
    </padding>

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="14.0">
        <HBox alignment="CENTER" minWidth="44.0" maxWidth="44.0" minHeight="44.0" maxHeight="44.0"
              styleClass="modal-icon-badge">
            <Region styleClass="icon-archive, modal-badge-glyph" />
        </HBox>
        <VBox spacing="3.0" HBox.hgrow="ALWAYS">
            <Label text="Archived Accounts" styleClass="dialog-title" />
            <Label text="Review archived staff accounts. You can restore them to active status or delete them permanently."
                   styleClass="dialog-subtitle" />
        </VBox>
        <Button onAction="#handleClose" text="✕" styleClass="btn-close-modal" />
    </HBox>

    <Region styleClass="dialog-divider" />

    <!-- Search bar -->
    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="filter-search-box" prefHeight="42.0">
        <Label text="🔍" style="-fx-text-fill: #A89B90; -fx-font-size: 13px;" />
        <TextField fx:id="searchField" promptText="Search archived accounts by name or username…"
                   styleClass="search-field" HBox.hgrow="ALWAYS" />
    </HBox>

    <!-- Table of Archived Accounts -->
    <VBox styleClass="modal-table-box" VBox.vgrow="ALWAYS">
        <TableView fx:id="archivedTable" styleClass="modern-audit-table, account-table" VBox.vgrow="ALWAYS">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colName"      prefWidth="210.0" text="NAME" styleClass="col-name-cell" />
                <TableColumn fx:id="colUsername"  prefWidth="130.0" text="USERNAME" style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="colRole"      prefWidth="120.0" text="ROLE" style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="colLastLogin" prefWidth="160.0" text="LAST LOGIN" style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="colCreated"   prefWidth="150.0" text="CREATED DATE" style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="colActions"   prefWidth="110.0" text="ACTIONS" style="-fx-alignment: CENTER;" />
            </columns>
        </TableView>
    </VBox>

    <!-- Footer -->
    <HBox alignment="CENTER_RIGHT" spacing="12.0">
        <Button onAction="#handleClose" text="Close" styleClass="btn-modal-close" />
    </HBox>
</VBox>
