<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefWidth="920.0" prefHeight="620.0" spacing="16.0" styleClass="account-dialog, modal-container"
      stylesheets="@../../../styles/admin/account/account.css, @../../../styles/admin/menu/menu.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.coffeepos.renespresso.controller.main.admin.menu.ArchivedMenuModalController">

    <padding>
        <Insets top="24.0" right="30.0" bottom="24.0" left="30.0" />
    </padding>

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="14.0">
        <HBox alignment="CENTER" minWidth="44.0" maxWidth="44.0" minHeight="44.0" maxHeight="44.0"
              styleClass="modal-icon-badge">
            <Region styleClass="icon-archive, modal-badge-glyph" />
        </HBox>
        <VBox spacing="3.0" HBox.hgrow="ALWAYS">
            <Label text="Archived Menu Items" styleClass="dialog-title" />
            <Label text="Review archived dishes and categories. You can restore them to the active menu or delete them permanently."
                   styleClass="dialog-subtitle" />
        </VBox>
        <Button onAction="#handleClose" text="✕" styleClass="btn-close-modal" />
    </HBox>

    <Region styleClass="dialog-divider" />

    <!-- Tab Bar & Search -->
    <HBox alignment="CENTER_LEFT" spacing="14.0">
        <HBox spacing="6.0" styleClass="modal-tab-bar">
            <ToggleButton fx:id="btnTabDishes" text="Dishes (0)" onAction="#handleSelectDishesTab"
                          styleClass="modal-tab-btn" />
            <ToggleButton fx:id="btnTabCategories" text="Categories (0)" onAction="#handleSelectCategoriesTab"
                          styleClass="modal-tab-btn" />
        </HBox>

        <Region HBox.hgrow="ALWAYS" />

        <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="filter-search-box" prefHeight="40.0" minWidth="320.0">
            <Label text="🔍" style="-fx-text-fill: #A89B90; -fx-font-size: 13px;" />
            <TextField fx:id="searchField" promptText="Search archived dishes…"
                       styleClass="search-field" HBox.hgrow="ALWAYS" />
        </HBox>
    </HBox>

    <!-- Content Switcher -->
    <StackPane VBox.vgrow="ALWAYS">
        <!-- DISHES PANE -->
        <VBox fx:id="dishesBox" styleClass="modal-table-box" VBox.vgrow="ALWAYS">
            <TableView fx:id="archivedDishesTable" styleClass="modern-audit-table, account-table" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colDishName" prefWidth="270.0" text="DISH" styleClass="col-name-cell" />
                    <TableColumn fx:id="colDishCategory" prefWidth="140.0" text="CATEGORY" style="-fx-alignment: CENTER;" />
                    <TableColumn fx:id="colDishPrices" prefWidth="210.0" text="PRICES / SIZES" style="-fx-alignment: CENTER;" />
                    <TableColumn fx:id="colDishQty" prefWidth="100.0" text="STOCK" style="-fx-alignment: CENTER;" />
                    <TableColumn fx:id="colDishActions" prefWidth="110.0" text="ACTIONS" style="-fx-alignment: CENTER;" />
                </columns>
            </TableView>
        </VBox>

        <!-- CATEGORIES PANE -->
        <VBox fx:id="categoriesBox" styleClass="modal-table-box" visible="false" managed="false" VBox.vgrow="ALWAYS">
            <TableView fx:id="archivedCategoriesTable" styleClass="modern-audit-table, account-table" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colCatName" prefWidth="350.0" text="CATEGORY NAME" styleClass="col-name-cell" />
                    <TableColumn fx:id="colCatDishes" prefWidth="260.0" text="ASSOCIATED DISHES" style="-fx-alignment: CENTER;" />
                    <TableColumn fx:id="colCatActions" prefWidth="140.0" text="ACTIONS" style="-fx-alignment: CENTER;" />
                </columns>
            </TableView>
        </VBox>
    </StackPane>

    <!-- Footer -->
    <HBox alignment="CENTER_RIGHT" spacing="12.0">
        <Button onAction="#handleClose" text="Close" styleClass="btn-modal-close" />
    </HBox>
</VBox>
