<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20.0" styleClass="transact-container"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.coffeepos.renespresso.controller.main.admin.transact.TransactionController">

    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="page-header">
        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
            <Label styleClass="transact-title" text="Transaction History" />
            <Label styleClass="transact-subtitle" text="Review orders, staff records, and payment history" />
        </VBox>
        <Label fx:id="lblSummary" styleClass="card-subtitle" />
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="card, filter-toolbar-card">
        <!-- search box now fills all the free space; the spacer Region is gone -->
        <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="filter-search-box"
              minWidth="280.0" maxWidth="Infinity" HBox.hgrow="ALWAYS">
            <Label text="🔍" style="-fx-text-fill: #A89B90; -fx-font-size: 13px;" />
            <TextField fx:id="txtSearch" promptText="Search Order ID or staff…"
                       styleClass="search-field" HBox.hgrow="ALWAYS" />
        </HBox>

        <HBox alignment="CENTER_RIGHT" spacing="12.0" minWidth="-Infinity">
            <ComboBox fx:id="cmbDateFilter" promptText="Date: All Dates" styleClass="filter-combo" prefWidth="140.0" />
            <ComboBox fx:id="cmbStatusFilter" promptText="Status: All States" styleClass="filter-combo" prefWidth="150.0" />
            <ComboBox fx:id="cmbPaymentFilter" promptText="Payment: All" styleClass="filter-combo" prefWidth="135.0" />
            <ComboBox fx:id="cmbSortFilter" promptText="Sort: Latest to Oldest" styleClass="filter-combo" prefWidth="180.0" />
            <Button fx:id="btnClearFilters" onAction="#handleClearFilters" text="Clear Filters" styleClass="btn-clear-filters" />
        </HBox>
    </HBox>

    <VBox styleClass="card, table-card" VBox.vgrow="ALWAYS">
        <TableView fx:id="tblTransactions" styleClass="modern-audit-table" VBox.vgrow="ALWAYS">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colOrderId" prefWidth="120.0" text="ORDER ID" style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="colStaff" prefWidth="180.0" text="STAFF" styleClass="col-staff-cell" />
                <TableColumn fx:id="colCreated" prefWidth="180.0" text="CREATED / LAST EDIT" style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="colTotal" prefWidth="120.0" text="TOTAL" style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="colStatus" prefWidth="140.0" text="STATUS" style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="colPayment" prefWidth="110.0" text="PAYMENT" style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="colActions" prefWidth="130.0" text="ACTIONS" style="-fx-alignment: CENTER;" />
            </columns>
        </TableView>
    </VBox>
</VBox>