<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20.0" styleClass="transact-container"
      stylesheets="@../../../styles/admin/transact/transact.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.coffeepos.renespresso.controller.main.admin.transact.TransactionController">

    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="page-header">
        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
            <Label styleClass="transact-title" text="Transaction History" />
            <Label styleClass="transact-subtitle" text="Review past orders, staff performance, and payment statuses" />
        </VBox>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="card, toolbar-card">
        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="search-box" HBox.hgrow="ALWAYS">
            <TextField fx:id="txtSearch" promptText="Search by order ID, staff, payment or status…"
                       styleClass="search-field" HBox.hgrow="ALWAYS" />
        </HBox>
        <Label fx:id="lblSummary" styleClass="empty-note" />
        <Button fx:id="btnRefresh" onAction="#loadTransactions" styleClass="btn-refresh" text="↻ Refresh" />
    </HBox>

    <VBox styleClass="card, table-card" VBox.vgrow="ALWAYS">
        <TableView fx:id="tblTransactions" styleClass="modern-audit-table" VBox.vgrow="ALWAYS">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colOrderId" prefWidth="120.0" text="ORDER ID" />
                <TableColumn fx:id="colStaff" prefWidth="180.0" text="STAFF" />
                <TableColumn fx:id="colCreated" prefWidth="180.0" text="CREATED / LAST EDIT" />
                <TableColumn fx:id="colTotal" prefWidth="120.0" text="TOTAL" />
                <TableColumn fx:id="colStatus" prefWidth="140.0" text="STATUS" />
                <TableColumn fx:id="colPayment" prefWidth="110.0" text="PAYMENT" />
                <TableColumn fx:id="colActions" prefWidth="130.0" text="ACTIONS" />
            </columns>
        </TableView>
    </VBox>
</VBox>