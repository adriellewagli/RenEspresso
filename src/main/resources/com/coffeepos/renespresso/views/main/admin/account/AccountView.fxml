<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20.0" styleClass="account-container, transact-container"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.coffeepos.renespresso.controller.main.admin.account.AccountController">

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="page-header">
        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
            <Label styleClass="account-title, page-title" text="Account Management" />
            <Label styleClass="account-subtitle, page-subtitle" text="Manage staff and cashier accounts" />
        </VBox>
        <HBox alignment="CENTER_RIGHT" spacing="12.0">
            <Button fx:id="archivedAccountsBtn" onAction="#handleOpenArchivedAccounts" styleClass="secondary-account-button" text="Archived Accounts (0)" />
            <Button fx:id="addAccountBtn" onAction="#handleAddAccount" styleClass="add-account-button" text="+  Add Account" />
        </HBox>
    </HBox>

    <!-- FILTER BAR -->
    <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="card, filter-toolbar-card">
        <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="filter-search-box"
              minWidth="260.0" maxWidth="Infinity" HBox.hgrow="ALWAYS">
            <Label text="🔍" style="-fx-text-fill: #A89B90; -fx-font-size: 13px;" />
            <TextField fx:id="searchField" promptText="Search accounts by name or username…"
                       styleClass="search-field" HBox.hgrow="ALWAYS" />
        </HBox>

        <HBox alignment="CENTER_RIGHT" spacing="12.0" minWidth="-Infinity">
            <ComboBox fx:id="roleFilter" promptText="Role: All Roles" styleClass="filter-combo" prefWidth="145.0" />
            <ComboBox fx:id="statusFilter" promptText="Status: All Statuses" styleClass="filter-combo" prefWidth="150.0" />
            <ComboBox fx:id="lastLoginFilter" promptText="Last Login: Anytime" styleClass="filter-combo" prefWidth="175.0" />
            <Button fx:id="clearFiltersBtn" onAction="#handleClearFilters" styleClass="btn-clear-filters" text="Clear Filters" />
        </HBox>
    </HBox>

    <!-- ACCOUNTS TABLE -->
    <VBox styleClass="card, table-card" VBox.vgrow="ALWAYS">
        <TableView fx:id="accountTable" styleClass="modern-audit-table, account-table" VBox.vgrow="ALWAYS">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colName"      prefWidth="220.0" text="NAME" styleClass="col-name-cell" />
                <TableColumn fx:id="colUsername"  prefWidth="160.0" text="USERNAME" style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="colRole"      prefWidth="130.0" text="ROLE" style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="colStatus"    prefWidth="130.0" text="STATUS" style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="colLastLogin" prefWidth="180.0" text="LAST LOGIN" style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="colCreated"   prefWidth="150.0" text="CREATED DATE" style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="colActions"   prefWidth="120.0" text="ACTIONS" style="-fx-alignment: CENTER;" />
            </columns>
        </TableView>
    </VBox>
</VBox>