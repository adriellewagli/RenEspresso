<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16.0" styleClass="account-root"
      stylesheets="@../../../styles/admin/account/account.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.coffeepos.renespresso.controller.main.admin.account.AccountController">

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="page-header">
        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
            <Label styleClass="page-title" text="Account Management" />
            <Label styleClass="page-subtitle" text="Manage staff and cashier accounts" />
        </VBox>
        <Button fx:id="addAccountBtn" onAction="#handleAddAccount" styleClass="add-account-button" text="+  Add Account" />
    </HBox>

    <!-- FILTER BAR -->
    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="card, filter-bar">
        <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="search-box" HBox.hgrow="ALWAYS">
            <Region styleClass="icon-search" />
            <TextField fx:id="searchField" promptText="Search accounts by name or email…"
                       styleClass="search-field" HBox.hgrow="ALWAYS" />
        </HBox>

        <ComboBox fx:id="roleFilter" styleClass="filter-combo" />
        <ComboBox fx:id="statusFilter" styleClass="filter-combo" />
        <ComboBox fx:id="lastLoginFilter" styleClass="filter-combo" />

        <Button fx:id="clearFiltersBtn" onAction="#handleClearFilters" styleClass="clear-filters" text="Clear Filters" />
    </HBox>

    <!-- ACCOUNTS TABLE -->
    <VBox styleClass="card, table-card" VBox.vgrow="ALWAYS">
        <TableView fx:id="accountTable" styleClass="account-table" VBox.vgrow="ALWAYS">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colName"      prefWidth="180.0" text="NAME" />
                <TableColumn fx:id="colUsername"  prefWidth="160.0" text="USERNAME" />
                <TableColumn fx:id="colRole"      prefWidth="110.0" text="ROLE" />
                <TableColumn fx:id="colStatus"    prefWidth="120.0" text="STATUS" />
                <TableColumn fx:id="colLastLogin" prefWidth="170.0" text="LAST LOGIN" />
                <TableColumn fx:id="colCreated"   prefWidth="140.0" text="CREATED DATE" />
                <TableColumn fx:id="colActions"   prefWidth="110.0" text="ACTIONS" />
            </columns>
        </TableView>
    </VBox>
</VBox>
