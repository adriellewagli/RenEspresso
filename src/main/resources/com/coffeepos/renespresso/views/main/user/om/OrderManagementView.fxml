<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fx:id="orderRoot" spacing="20.0" styleClass="view-container"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.coffeepos.renespresso.controller.main.user.om.OrderManagementController">

    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="page-header">
        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
            <Label styleClass="page-title" text="Transaction History" />
            <Label styleClass="page-subtitle" text="Review orders, staff records, and payment history" />
        </VBox>
        <Label fx:id="lblHistorySummary" styleClass="card-subtitle" />
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="card, filter-toolbar-card">
        <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="filter-search-box" prefWidth="280.0">
            <Label text="🔍" style="-fx-text-fill: #A89B90; -fx-font-size: 13px;" />
            <TextField fx:id="txtHistorySearch" promptText="Search Order ID or staff…"
                       styleClass="search-field" HBox.hgrow="ALWAYS" />
        </HBox>

        <Region HBox.hgrow="ALWAYS" />

        <HBox alignment="CENTER_RIGHT" spacing="12.0">
            <ComboBox fx:id="cmbDateFilter" promptText="Date: All Dates" styleClass="filter-combo" prefWidth="150.0" />
            <ComboBox fx:id="cmbStatusFilter" promptText="Status: All States" styleClass="filter-combo" prefWidth="160.0" />
            <ComboBox fx:id="cmbPaymentFilter" promptText="Payment: All" styleClass="filter-combo" prefWidth="140.0" />
            <Button fx:id="btnClearFilters" onAction="#handleClearFilters" text="Clear Filters" styleClass="btn-clear-filters" />
        </HBox>
    </HBox>

    <VBox styleClass="card, table-card" VBox.vgrow="ALWAYS">
        <TableView fx:id="tblHistory" styleClass="modern-audit-table" VBox.vgrow="ALWAYS">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colOrderId" prefWidth="120.0" text="ORDER ID" />
                <TableColumn fx:id="colStaff" prefWidth="180.0" text="STAFF" />
                <TableColumn fx:id="colCreated" prefWidth="180.0" text="CREATED / LAST EDIT" />
                <TableColumn fx:id="colTotal" prefWidth="120.0" text="TOTAL" />
                <TableColumn fx:id="colStatus" prefWidth="140.0" text="STATUS" />
                <TableColumn fx:id="colPayment" prefWidth="110.0" text="PAYMENT" />
                <TableColumn fx:id="colActions" prefWidth="130.0" text="ACTIONS" />
            </columns>
        </TableView>
    </VBox>
</VBox>
