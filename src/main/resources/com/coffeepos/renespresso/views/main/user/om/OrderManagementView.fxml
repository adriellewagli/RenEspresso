<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fx:id="orderRoot" spacing="20.0" styleClass="view-container"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.coffeepos.renespresso.controller.main.user.om.OrderManagementController">

    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="page-header">
        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
            <Label styleClass="page-title" text="Transaction History" />
            <Label styleClass="page-subtitle" text="Review this shift's orders and payments" />
        </VBox>
        <Button onAction="#handleReprintReceipt" styleClass="btn-secondary" text="View Receipt" />
        <Button onAction="#handleExportHistory" styleClass="btn-primary" text="Export CSV" />
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="card, toolbar-card">
        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="search-box" HBox.hgrow="ALWAYS">
            <Region styleClass="icon-search" />
            <TextField fx:id="txtHistorySearch" promptText="Search by ticket, item, payment or status…"
                       styleClass="search-field" HBox.hgrow="ALWAYS" />
        </HBox>
        <Label fx:id="lblHistorySummary" styleClass="card-subtitle" />
    </HBox>

    <VBox styleClass="card, table-card" VBox.vgrow="ALWAYS">
        <TableView fx:id="tblHistory" styleClass="modern-audit-table" VBox.vgrow="ALWAYS">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <columns>
                <TableColumn prefWidth="90.0" text="TICKET" />
                <TableColumn prefWidth="100.0" text="TIME" />
                <TableColumn prefWidth="260.0" text="ITEMS" />
                <TableColumn prefWidth="140.0" text="DISCOUNT" />
                <TableColumn prefWidth="100.0" text="PAYMENT" />
                <TableColumn prefWidth="110.0" text="TOTAL" />
                <TableColumn prefWidth="110.0" text="STATUS" />
            </columns>
        </TableView>
    </VBox>
</VBox>
