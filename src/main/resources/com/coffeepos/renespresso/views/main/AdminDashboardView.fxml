<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import io.github.palexdev.materialfx.controls.*?>

<StackPane prefHeight="768.0" prefWidth="1280.0"
           style="-fx-background-color: #F3E9DC;"
           stylesheets="@../styles/dashboard.css"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.coffeepos.renespresso.controller.main.AdminDashboardController">
    <!-- MAIN APP LAYOUT -->
    <HBox prefHeight="768.0" prefWidth="1280.0">
        <!-- SIDEBAR NAVIGATION -->
        <VBox prefWidth="250.0" spacing="10.0" style="-fx-background-color: #5E3023; -fx-padding: 16 15 20 15;">

            <!-- Logo Header -->
            <HBox alignment="CENTER_LEFT" prefHeight="42.0" spacing="10.0" style="-fx-padding: 0 0 2 0;">
                <Label style="-fx-text-fill: #F3E9DC; -fx-font-size: 24px; -fx-font-weight: bold;" text="☕ RenEspresso" />
            </HBox>

            <Separator style="-fx-opacity: 0.2;" />

            <!-- System Status & Admin Info -->
            <VBox spacing="4.0" style="-fx-background-color: rgba(243, 233, 220, 0.1); -fx-padding: 10; -fx-background-radius: 8;">
                <HBox alignment="CENTER_LEFT" spacing="6">
                    <Region style="-fx-background-color: #2ECC71; -fx-min-width: 8; -fx-min-height: 8; -fx-max-width: 8; -fx-max-height: 8; -fx-background-radius: 4;" />
                    <Label style="-fx-text-fill: #F3E9DC; -fx-font-size: 11px; -fx-font-weight: bold;" text="ADMIN PORTAL" />
                </HBox>
                <Label style="-fx-text-fill: #F3E9DC; -fx-font-size: 12px; -fx-font-weight: bold;" text="Administrator" />
                <Label fx:id="dateLabel" style="-fx-text-fill: #C08552; -fx-font-size: 11px;" text="Monday, Sep 29, 2026" />
            </VBox>

            <!-- Categorized Navigation Menu -->
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                <content>
                    <VBox spacing="10.0" style="-fx-background-color: transparent;">

                        <!-- CATEGORY 1: MAIN -->
                        <Label style="-fx-text-fill: #C08552; -fx-font-size: 10px; -fx-font-weight: bold;" text="MAIN" />
                        <Button fx:id="btnDashboard" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#showDashboard" style="-fx-background-color: #C08552; -fx-text-fill: #F3E9DC; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 8;" text="📊  Dashboard" />

                        <!-- CATEGORY 2: OPERATIONS -->
                        <Label style="-fx-text-fill: #C08552; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 6 0 0 0;" text="OPERATIONS &amp; CATALOG" />
                        <Button fx:id="btnProducts" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#showProducts" style="-fx-background-color: transparent; -fx-text-fill: #F3E9DC; -fx-font-size: 13px; -fx-cursor: hand; -fx-background-radius: 8;" text="📋  Products Catalog" />
                        <Button fx:id="btnInventory" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#showInventory" style="-fx-background-color: transparent; -fx-text-fill: #F3E9DC; -fx-font-size: 13px; -fx-cursor: hand; -fx-background-radius: 8;" text="📦  Inventory &amp; Supplies" />
                        <Button fx:id="btnSales" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#showSales" style="-fx-background-color: transparent; -fx-text-fill: #F3E9DC; -fx-font-size: 13px; -fx-cursor: hand; -fx-background-radius: 8;" text="📈  Sales Reports" />

                        <!-- CATEGORY 3: GOVERNANCE -->
                        <Label style="-fx-text-fill: #C08552; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 6 0 0 0;" text="GOVERNANCE" />
                        <Button fx:id="btnStaff" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#showStaff" style="-fx-background-color: transparent; -fx-text-fill: #F3E9DC; -fx-font-size: 13px; -fx-cursor: hand; -fx-background-radius: 8;" text="👥  Staff &amp; Permissions" />
                        <Button fx:id="btnAudit" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#showAuditLogs" style="-fx-background-color: transparent; -fx-text-fill: #F3E9DC; -fx-font-size: 13px; -fx-cursor: hand; -fx-background-radius: 8;" text="📝  Audit Logs" />

                        <!-- CATEGORY 4: SYSTEM -->
                        <Label style="-fx-text-fill: #C08552; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 6 0 0 0;" text="SYSTEM" />
                        <Button fx:id="btnSettings" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#showSettings" style="-fx-background-color: transparent; -fx-text-fill: #F3E9DC; -fx-font-size: 13px; -fx-cursor: hand; -fx-background-radius: 8;" text="⚙️  Store Settings" />
                    </VBox>
                </content>
            </ScrollPane>

            <Separator style="-fx-opacity: 0.2;" />

            <!-- Logout Button (MaterialFX Ripple Button) -->
            <MFXButton fx:id="btnLogout" maxWidth="Infinity" onAction="#handleLogout" style="-fx-background-color: #895737; -fx-text-fill: #F3E9DC; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 8; -fx-padding: 10 15;" text="🚪  Logout" />
        </VBox>

        <!-- CONTENT AREA (Swappable Views) -->
        <StackPane HBox.hgrow="ALWAYS">

            <!-- VIEW 1: MAIN DASHBOARD -->
            <ScrollPane fx:id="dashboardView" fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" visible="true">
                <content>
                    <VBox spacing="20.0" style="-fx-padding: 25;">
                        <children>
                            <VBox spacing="4.0">
                                <Label style="-fx-text-fill: #5E3023; -fx-font-size: 26px; -fx-font-weight: bold;" text="Admin Dashboard" />
                                <Label style="-fx-text-fill: #895737; -fx-font-size: 14px;" text="Overview of store sales health and operational diagnostics" />
                            </VBox>

                            <!-- ROW 1: 4 KPI CARDS -->
                            <HBox spacing="16.0">
                                <children>
                                    <VBox HBox.hgrow="ALWAYS" styleClass="dashboard-card" spacing="6.0">
                                        <Label text="Today's Sales" styleClass="card-title" />
                                        <Label fx:id="lblTodaySales" text="₱25,450.00" styleClass="card-metric-value" />
                                        <Label text="+12.4% from yesterday" styleClass="card-subtext-green" />
                                    </VBox>
                                    <VBox HBox.hgrow="ALWAYS" styleClass="dashboard-card" spacing="6.0">
                                        <Label text="Transactions" styleClass="card-title" />
                                        <Label fx:id="lblTotalTransactions" text="142" styleClass="card-metric-value" />
                                        <Label text="Average spend: ₱179.20" styleClass="card-subtext" />
                                    </VBox>
                                    <VBox HBox.hgrow="ALWAYS" styleClass="dashboard-card" spacing="6.0">
                                        <Label text="Completed Orders" styleClass="card-title" />
                                        <Label text="98" styleClass="card-metric-value" />
                                        <Label text="8 pending in kitchen" styleClass="card-subtext" />
                                    </VBox>
                                    <VBox HBox.hgrow="ALWAYS" styleClass="dashboard-card" spacing="6.0">
                                        <Label text="Low Stock Alerts" styleClass="card-title" />
                                        <Label fx:id="lblLowStock" text="3" styleClass="card-metric-value-red" />
                                        <Label text="Whole Milk, Oat Milk, Caramel" styleClass="card-subtext-red" />
                                    </VBox>
                                </children>
                            </HBox>

                            <!-- ROW 2: AUDIT LOGS TABLE -->
                            <VBox styleClass="dashboard-card" spacing="12.0">
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="System Audit Logs &amp; Overrides" styleClass="section-title" />
                                </HBox>
                                <TableView fx:id="auditTable" prefHeight="320.0" styleClass="modern-audit-table">
                                    <columns>
                                        <TableColumn fx:id="colTime" text="TIMESTAMP" prefWidth="130.0" />
                                        <TableColumn fx:id="colUser" text="USER ACCOUNT" prefWidth="140.0" />
                                        <TableColumn fx:id="colRole" text="ROLE" prefWidth="110.0" />
                                        <TableColumn fx:id="colAction" text="ACTION PERFORMED" prefWidth="220.0" />
                                        <TableColumn fx:id="colDetails" text="AUDIT DETAILS &amp; CONTEXT" prefWidth="380.0" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </VBox>
                        </children>
                    </VBox>
                </content>
            </ScrollPane>

            <!-- VIEW 2: PRODUCTS CATALOG -->
            <VBox fx:id="productsView" spacing="20.0" style="-fx-padding: 25;" visible="false">
                <VBox spacing="4.0">
                    <Label style="-fx-text-fill: #5E3023; -fx-font-size: 26px; -fx-font-weight: bold;" text="Products Catalog" />
                    <Label style="-fx-text-fill: #895737; -fx-font-size: 14px;" text="Configure menu items, prices, modifiers, and categories." />
                </VBox>
                <VBox styleClass="dashboard-card" spacing="15.0" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Active Menu Items" styleClass="section-title" />
                        <Region HBox.hgrow="ALWAYS" />
                        <MFXButton style="-fx-background-color: #5E3023; -fx-text-fill: #F3E9DC; -fx-background-radius: 8; -fx-padding: 8 16; -fx-font-weight: bold;" text="+ Add New Product" />
                    </HBox>
                    <Label style="-fx-text-fill: #895737; -fx-font-size: 13px;" text="Product grid / table data integration placeholder." />
                </VBox>
            </VBox>

            <!-- VIEW 3: INVENTORY & SUPPLIES -->
            <VBox fx:id="inventoryView" spacing="20.0" style="-fx-padding: 25;" visible="false">
                <VBox spacing="4.0">
                    <Label style="-fx-text-fill: #5E3023; -fx-font-size: 26px; -fx-font-weight: bold;" text="Inventory &amp; Raw Supplies" />
                    <Label style="-fx-text-fill: #895737; -fx-font-size: 14px;" text="Track raw ingredients, milk, espresso beans, cups, and syrups." />
                </VBox>
                <VBox styleClass="dashboard-card" spacing="15.0" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Stock Levels" styleClass="section-title" />
                        <Region HBox.hgrow="ALWAYS" />
                        <MFXButton style="-fx-background-color: #C08552; -fx-text-fill: #F3E9DC; -fx-background-radius: 8; -fx-padding: 8 16; -fx-font-weight: bold;" text="📦 Restock Ingredient" />
                    </HBox>
                    <Label style="-fx-text-fill: #895737; -fx-font-size: 13px;" text="Stock management table placeholder." />
                </VBox>
            </VBox>

            <!-- VIEW 4: SALES REPORTS -->
            <VBox fx:id="salesView" spacing="20.0" style="-fx-padding: 25;" visible="false">
                <VBox spacing="4.0">
                    <Label style="-fx-text-fill: #5E3023; -fx-font-size: 26px; -fx-font-weight: bold;" text="Sales Reports &amp; Analytics" />
                    <Label style="-fx-text-fill: #895737; -fx-font-size: 14px;" text="Detailed store performance breakdown, revenue metrics, and exports." />
                </VBox>
                <VBox styleClass="dashboard-card" spacing="15.0" VBox.vgrow="ALWAYS">
                    <Label text="Revenue Breakdown" styleClass="section-title" />
                    <Label style="-fx-text-fill: #895737; -fx-font-size: 13px;" text="Sales chart and export reporting placeholder." />
                </VBox>
            </VBox>

            <!-- VIEW 5: STAFF & PERMISSIONS -->
            <VBox fx:id="staffView" spacing="20.0" style="-fx-padding: 25;" visible="false">
                <VBox spacing="4.0">
                    <Label style="-fx-text-fill: #5E3023; -fx-font-size: 26px; -fx-font-weight: bold;" text="Staff &amp; Permissions" />
                    <Label style="-fx-text-fill: #895737; -fx-font-size: 14px;" text="Manage cashier accounts, role credentials, and administrative access." />
                </VBox>
                <VBox styleClass="dashboard-card" spacing="15.0" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="System Accounts" styleClass="section-title" />
                        <Region HBox.hgrow="ALWAYS" />
                        <MFXButton style="-fx-background-color: #5E3023; -fx-text-fill: #F3E9DC; -fx-background-radius: 8; -fx-padding: 8 16; -fx-font-weight: bold;" text="+ Create Staff Account" />
                    </HBox>
                    <Label style="-fx-text-fill: #895737; -fx-font-size: 13px;" text="Staff account table placeholder." />
                </VBox>
            </VBox>

            <!-- VIEW 6: DEDICATED AUDIT LOGS -->
            <VBox fx:id="auditView" spacing="20.0" style="-fx-padding: 25;" visible="false">
                <VBox spacing="4.0">
                    <Label style="-fx-text-fill: #5E3023; -fx-font-size: 26px; -fx-font-weight: bold;" text="Full Audit Logs &amp; Overrides" />
                    <Label style="-fx-text-fill: #895737; -fx-font-size: 14px;" text="Complete security audit history, manager overrides, and void records." />
                </VBox>
                <VBox styleClass="dashboard-card" spacing="15.0" VBox.vgrow="ALWAYS">
                    <Label text="System Operations Trail" styleClass="section-title" />
                    <Label style="-fx-text-fill: #895737; -fx-font-size: 13px;" text="Detailed audit trail search and history placeholder." />
                </VBox>
            </VBox>

            <!-- VIEW 7: STORE SETTINGS -->
            <VBox fx:id="settingsView" spacing="20.0" style="-fx-padding: 25;" visible="false">
                <VBox spacing="4.0">
                    <Label style="-fx-text-fill: #5E3023; -fx-font-size: 26px; -fx-font-weight: bold;" text="Store &amp; System Settings" />
                    <Label style="-fx-text-fill: #895737; -fx-font-size: 14px;" text="Receipt headers, printer settings, tax rates, and local database backup." />
                </VBox>
                <VBox styleClass="dashboard-card" spacing="15.0" VBox.vgrow="ALWAYS">
                    <Label text="POS Hardware &amp; Store Configuration" styleClass="section-title" />
                    <Label style="-fx-text-fill: #895737; -fx-font-size: 13px;" text="System configuration settings placeholder." />
                </VBox>
            </VBox>

        </StackPane>
    </HBox>
</StackPane>