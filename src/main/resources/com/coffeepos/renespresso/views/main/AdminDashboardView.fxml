<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="768.0" prefWidth="1280.0" style="-fx-background-color: #F3E9DC;" stylesheets="@../styles/dashboard.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.coffeepos.renespresso.controller.main.AdminDashboardController">

    <!-- MAIN APP LAYOUT -->
    <HBox prefHeight="768.0" prefWidth="1280.0">
        <!-- SIDEBAR NAVIGATION -->
        <VBox prefWidth="250.0" spacing="12.0" style="-fx-background-color: #5E3023; -fx-padding: 16 15 20 15;">

            <!-- Logo Header -->
            <HBox alignment="CENTER_LEFT" prefHeight="42.0" spacing="10.0" style="-fx-padding: 0 0 2 0;">
                <Label style="-fx-text-fill: #F3E9DC; -fx-font-size: 24px; -fx-font-weight: bold;" text="☕ RenEspresso" />
            </HBox>

            <Separator style="-fx-opacity: 0.2;" />

            <!-- System Status & Admin Info -->
            <VBox spacing="4.0" style="-fx-background-color: rgba(243, 233, 220, 0.1); -fx-padding: 10; -fx-background-radius: 8;">
                <HBox alignment="CENTER_LEFT" spacing="6">
                    <Region style="-fx-background-color: #2ECC71; -fx-min-width: 8; -fx-min-height: 8; -fx-max-width: 8; -fx-max-height: 8; -fx-background-radius: 4;" />
                    <Label style="-fx-text-fill: #F3E9DC; -fx-font-size: 11px; -fx-font-weight: bold;" text="ADMIN PORTAL" />
                </HBox>
                <Label style="-fx-text-fill: #F3E9DC; -fx-font-size: 12px; -fx-font-weight: bold;" text="Administrator" />
                <Label fx:id="dateLabel" style="-fx-text-fill: #C08552; -fx-font-size: 11px;" text="Monday, Sep 29, 2026" />
            </VBox>

            <!-- Navigation Buttons -->
            <VBox spacing="8.0" VBox.vgrow="ALWAYS">
                <Button fx:id="btnDashboard" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#showDashboard" style="-fx-background-color: #C08552; -fx-text-fill: #F3E9DC; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 8;" text="📊  Dashboard" />
                <Button fx:id="btnStaff" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#showStaff" style="-fx-background-color: transparent; -fx-text-fill: #F3E9DC; -fx-font-size: 14px; -fx-cursor: hand; -fx-background-radius: 8;" text="👥  Staff &amp; Users" />
                <Button fx:id="btnProducts" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#showProducts" style="-fx-background-color: transparent; -fx-text-fill: #F3E9DC; -fx-font-size: 14px; -fx-cursor: hand; -fx-background-radius: 8;" text="📋  Products Management" />
                <Button fx:id="btnInventory" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#showInventory" style="-fx-background-color: transparent; -fx-text-fill: #F3E9DC; -fx-font-size: 14px; -fx-cursor: hand; -fx-background-radius: 8;" text="📦  Inventory Stock" />
                <Button fx:id="btnSales" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#showSales" style="-fx-background-color: transparent; -fx-text-fill: #F3E9DC; -fx-font-size: 14px; -fx-cursor: hand; -fx-background-radius: 8;" text="📈  Sales Reports" />
            </VBox>

            <Separator style="-fx-opacity: 0.2;" />

            <!-- Logout Button -->
            <Button fx:id="btnLogout" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#handleLogout" style="-fx-background-color: #895737; -fx-text-fill: #F3E9DC; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 8; -fx-padding: 10 15;" text="🚪  Logout" />
        </VBox>

        <!-- CONTENT AREA (Swappable Views) -->
        <StackPane HBox.hgrow="ALWAYS">

            <!-- VIEW 1: MAIN DASHBOARD -->
            <ScrollPane fx:id="dashboardView" fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" visible="true">
                <content>
                    <VBox spacing="20.0" style="-fx-padding: 25;">
                        <children>
                            <VBox spacing="4.0">
                                <Label style="-fx-text-fill: #5E3023; -fx-font-size: 26px; -fx-font-weight: bold;" text="Admin Dashboard" />
                                <Label style="-fx-text-fill: #895737; -fx-font-size: 14px;" text="Overview of store sales health and operational diagnostics" />
                            </VBox>

                            <!-- ROW 1: 4 KPI CARDS -->
                            <HBox spacing="16.0">
                                <children>
                                    <VBox HBox.hgrow="ALWAYS" styleClass="dashboard-card" spacing="6.0">
                                        <Label text="Today's Sales" styleClass="card-title" />
                                        <Label fx:id="lblTodaySales" text="₱25,450.00" styleClass="card-metric-value" />
                                        <Label text="+12.4% from yesterday" styleClass="card-subtext-green" />
                                    </VBox>
                                    <VBox HBox.hgrow="ALWAYS" styleClass="dashboard-card" spacing="6.0">
                                        <Label text="Transactions" styleClass="card-title" />
                                        <Label fx:id="lblTotalTransactions" text="142" styleClass="card-metric-value" />
                                        <Label text="Average spend: ₱179.20" styleClass="card-subtext" />
                                    </VBox>
                                    <VBox HBox.hgrow="ALWAYS" styleClass="dashboard-card" spacing="6.0">
                                        <Label text="Completed Orders" styleClass="card-title" />
                                        <Label text="98" styleClass="card-metric-value" />
                                        <Label text="8 pending in kitchen" styleClass="card-subtext" />
                                    </VBox>
                                    <VBox HBox.hgrow="ALWAYS" styleClass="dashboard-card" spacing="6.0">
                                        <Label text="Low Stock Alerts" styleClass="card-title" />
                                        <Label fx:id="lblLowStock" text="3" styleClass="card-metric-value-red" />
                                        <Label text="Whole Milk, Oat Milk, Caramel" styleClass="card-subtext-red" />
                                    </VBox>
                                </children>
                            </HBox>

                            <!-- ROW 2: AUDIT LOGS TABLE -->
                            <VBox styleClass="dashboard-card" spacing="12.0">
                                <Label text="System Audit Logs &amp; Overrides" styleClass="section-title" />
                                <TableView fx:id="auditTable" prefHeight="320.0" styleClass="modern-audit-table">
                                    <columns>
                                        <TableColumn fx:id="colTime" text="TIMESTAMP" prefWidth="130.0" />
                                        <TableColumn fx:id="colUser" text="USER ACCOUNT" prefWidth="140.0" />
                                        <TableColumn fx:id="colRole" text="ROLE" prefWidth="110.0" />
                                        <TableColumn fx:id="colAction" text="ACTION PERFORMED" prefWidth="220.0" />
                                        <TableColumn fx:id="colDetails" text="AUDIT DETAILS &amp; CONTEXT" prefWidth="380.0" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </VBox>
                        </children>
                    </VBox>
                </content>
            </ScrollPane>

            <!-- VIEW 2: STAFF & USERS (Placeholder matching view pattern) -->
            <VBox fx:id="staffView" spacing="15.0" style="-fx-padding: 25;" visible="false">
                <Label style="-fx-text-fill: #5E3023; -fx-font-size: 24px; -fx-font-weight: bold;" text="Staff &amp; User Accounts" />
                <Label style="-fx-text-fill: #895737; -fx-font-size: 14px;" text="Manage cashier accounts, permissions, and roles." />
            </VBox>

            <!-- VIEW 3: PRODUCTS -->
            <VBox fx:id="productsView" spacing="15.0" style="-fx-padding: 25;" visible="false">
                <Label style="-fx-text-fill: #5E3023; -fx-font-size: 24px; -fx-font-weight: bold;" text="Products Catalog" />
                <Label style="-fx-text-fill: #895737; -fx-font-size: 14px;" text="Configure menu items, prices, and categories." />
            </VBox>

            <!-- VIEW 4: INVENTORY -->
            <VBox fx:id="inventoryView" spacing="15.0" style="-fx-padding: 25;" visible="false">
                <Label style="-fx-text-fill: #5E3023; -fx-font-size: 24px; -fx-font-weight: bold;" text="Inventory Stock" />
                <Label style="-fx-text-fill: #895737; -fx-font-size: 14px;" text="Track raw ingredients, milk, cups, and supplies." />
            </VBox>

            <!-- VIEW 5: SALES REPORTS -->
            <VBox fx:id="salesView" spacing="15.0" style="-fx-padding: 25;" visible="false">
                <Label style="-fx-text-fill: #5E3023; -fx-font-size: 24px; -fx-font-weight: bold;" text="Sales Reports &amp; Analytics" />
                <Label style="-fx-text-fill: #895737; -fx-font-size: 14px;" text="Detailed performance breakdown and exportable records." />
            </VBox>

        </StackPane>
    </HBox>
</StackPane>