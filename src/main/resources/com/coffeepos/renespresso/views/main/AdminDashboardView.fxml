<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="768.0" prefWidth="1280.0"
           style="-fx-background-color: #F3E9DC; -fx-font-family: 'Segoe UI', sans-serif;"
           stylesheets="@../../style/main/dashboard.css"
           xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.coffeepos.renespresso.controller.main.AdminDashboardController">

    <HBox prefHeight="768.0" prefWidth="1280.0">
        <!-- SIDEBAR -->
        <VBox prefWidth="220.0" spacing="15.0" style="-fx-background-color: #5E3023; -fx-padding: 20 15 20 15;">
            <!-- Brand / Logo Header -->
            <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-padding: 0 0 10 0;">
                <Label style="-fx-text-fill: #F3E9DC; -fx-font-size: 20px; -fx-font-weight: bold;" text="☕ RenEspresso" />
            </HBox>

            <Separator style="-fx-opacity: 0.2;" />

            <!-- Navigation Buttons -->
            <Button fx:id="btnDashboard" alignment="BASELINE_LEFT" maxWidth="Infinity"
                    style="-fx-background-color: #C08552; -fx-text-fill: #F3E9DC; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 8;" text="📊  Dashboard" />

            <Button fx:id="btnStaff" alignment="BASELINE_LEFT" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #F3E9DC; -fx-font-size: 14px; -fx-cursor: hand; -fx-background-radius: 8;" text="👥  Staff &amp; Users" />

            <Button fx:id="btnProducts" alignment="BASELINE_LEFT" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #F3E9DC; -fx-font-size: 14px; -fx-cursor: hand; -fx-background-radius: 8;" text="☕  Product Menu" />

            <Button fx:id="btnInventory" alignment="BASELINE_LEFT" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #F3E9DC; -fx-font-size: 14px; -fx-cursor: hand; -fx-background-radius: 8;" text="📦  Inventory" />

            <Button fx:id="btnSales" alignment="BASELINE_LEFT" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #F3E9DC; -fx-font-size: 14px; -fx-cursor: hand; -fx-background-radius: 8;" text="📈  Sales &amp; Z-Read" />

            <!-- Manager Info Card (Placed right under Sales & Z-Read) -->
            <VBox spacing="4.0" style="-fx-background-color: rgba(243, 233, 220, 0.12); -fx-padding: 12 10; -fx-background-radius: 8;">
                <Label fx:id="adminNameLabel" style="-fx-text-fill: #F3E9DC; -fx-font-size: 12px; -fx-font-weight: bold;" text="Manager" />
                <Label fx:id="activeShiftLabel" style="-fx-text-fill: #C08552; -fx-font-size: 11px;" text="Morning Shift" />
            </VBox>

            <!-- Spacer pushes Logout to the bottom -->
            <Region VBox.vgrow="ALWAYS" />

            <!-- Logout Button (Isolated at the bottom) -->
            <Button fx:id="btnLogout" alignment="BASELINE_LEFT" maxWidth="Infinity"
                    style="-fx-background-color: rgba(217, 83, 79, 0.2); -fx-text-fill: #FFB3B3; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 8; -fx-padding: 10 14;" text="🚪  Logout" />
        </VBox>

        <!-- MAIN CONTENT AREA -->
        <VBox spacing="20.0" style="-fx-padding: 25;" HBox.hgrow="ALWAYS">

            <!-- Header Title Banner -->
            <VBox spacing="5.0">
                <HBox alignment="CENTER_LEFT">
                    <Label style="-fx-text-fill: #5E3023; -fx-font-size: 26px; -fx-font-weight: bold;" text="Admin Dashboard" />
                    <Label style="-fx-text-fill: #895737; -fx-font-size: 18px;" text="  /  Overview" />
                </HBox>
                <Label style="-fx-text-fill: #895737; -fx-font-size: 14px;" text="Real-time management metrics, system updates, and audit logs." />
            </VBox>

            <!-- ROW 1: KPI METRIC CARDS -->
            <HBox spacing="20.0">
                <VBox HBox.hgrow="ALWAYS" prefWidth="250.0" spacing="8.0"
                      style="-fx-background-color: #FFFFFF; -fx-padding: 20; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 8, 0, 0, 2);">
                    <Label style="-fx-text-fill: #895737; -fx-font-size: 13px; -fx-font-weight: bold;" text="TODAY'S SALES" />
                    <Label fx:id="lblTodaySales" style="-fx-text-fill: #5E3023; -fx-font-size: 28px; -fx-font-weight: bold;" text="₱14,825.00" />
                    <Label style="-fx-text-fill: #2E7D32; -fx-font-size: 11px; -fx-font-weight: bold;" text="+12.4% vs yesterday" />
                </VBox>

                <VBox HBox.hgrow="ALWAYS" prefWidth="250.0" spacing="8.0"
                      style="-fx-background-color: #FFFFFF; -fx-padding: 20; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 8, 0, 0, 2);">
                    <Label style="-fx-text-fill: #895737; -fx-font-size: 13px; -fx-font-weight: bold;" text="TRANSACTIONS" />
                    <Label fx:id="lblTotalTransactions" style="-fx-text-fill: #5E3023; -fx-font-size: 28px; -fx-font-weight: bold;" text="142 Orders" />
                    <Label style="-fx-text-fill: #895737; -fx-font-size: 11px;" text="Avg ₱104.40 / order" />
                </VBox>

                <VBox HBox.hgrow="ALWAYS" prefWidth="250.0" spacing="8.0"
                      style="-fx-background-color: #FFFFFF; -fx-padding: 20; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 8, 0, 0, 2);">
                    <Label style="-fx-text-fill: #895737; -fx-font-size: 13px; -fx-font-weight: bold;" text="TOP SELLER" />
                    <Label fx:id="lblTopSeller" style="-fx-text-fill: #C08552; -fx-font-size: 28px; -fx-font-weight: bold;" text="Spanish Latte" />
                    <Label style="-fx-text-fill: #895737; -fx-font-size: 11px;" text="68 Cups Sold" />
                </VBox>

                <VBox HBox.hgrow="ALWAYS" prefWidth="250.0" spacing="8.0"
                      style="-fx-background-color: #FFFFFF; -fx-padding: 20; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 8, 0, 0, 2);">
                    <Label style="-fx-text-fill: #895737; -fx-font-size: 13px; -fx-font-weight: bold;" text="LOW STOCK ALERTS" />
                    <Label fx:id="lblLowStock" style="-fx-text-fill: #C62828; -fx-font-size: 28px; -fx-font-weight: bold;" text="3 Items" />
                    <Label style="-fx-text-fill: #C62828; -fx-font-size: 11px;" text="Whole Milk, Oat Milk, Caramel" />
                </VBox>
            </HBox>

            <!-- ROW 2: MODERNIZED AUDIT LOGS CONTAINER -->
            <VBox VBox.vgrow="ALWAYS" spacing="14.0"
                  style="-fx-background-color: #FFFFFF; -fx-padding: 22; -fx-background-radius: 14; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 12, 0, 0, 3);">

                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="2.0">
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #5E3023;" text="System Audit Logs" />
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #895737;" text="Real-time log of security events and manager overrides" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button text="🔄 Refresh Logs"
                            style="-fx-background-color: #F3E9DC; -fx-text-fill: #5E3023; -fx-font-weight: bold; -fx-font-size: 12px; -fx-background-radius: 8; -fx-padding: 8 14; -fx-cursor: hand;" />
                </HBox>

                <!-- Modern TableView -->
                <TableView fx:id="auditTable" VBox.vgrow="ALWAYS" styleClass="modern-audit-table">
                    <columns>
                        <TableColumn fx:id="colTime" prefWidth="130" text="TIMESTAMP" />
                        <TableColumn fx:id="colUser" prefWidth="140" text="USER" />
                        <TableColumn fx:id="colRole" prefWidth="120" text="ROLE" />
                        <TableColumn fx:id="colAction" prefWidth="210" text="ACTION" />
                        <TableColumn fx:id="colDetails" prefWidth="380" text="DETAILS" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>

        </VBox>
    </HBox>
</StackPane>