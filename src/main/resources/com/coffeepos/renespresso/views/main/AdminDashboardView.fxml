<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="768.0" prefWidth="1200.0"
            style="-fx-background-color: #FAF8F5;"
            stylesheets="@style/main/dashboard.css"
            xmlns="http://javafx.com/fxml/1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.coffeepos.renespresso.controller.main.AdminDashboardController">

    <!-- TOP HEADER -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" style="-fx-background-color: #FFFFFF; -fx-padding: 0 24; -fx-border-color: #EFE8E0; -fx-border-width: 0 0 1 0;">
            <children>
                <Label text="RENESPRESSO" textFill="#5C3A21">
                    <font><Font name="System Bold" size="17.0" /></font>
                </Label>
                <Label text="  /  Dashboard" textFill="#9C8C80">
                    <font><Font size="15.0" /></font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="activeShiftLabel" text="Morning Shift" style="-fx-background-color: #F5EBE1; -fx-text-fill: #A0522D; -fx-padding: 4 12; -fx-background-radius: 20; -fx-font-size: 11px; -fx-font-weight: bold;">
                    <HBox.margin><Insets right="12.0" /></HBox.margin>
                </Label>
                <Label fx:id="adminNameLabel" text="Manager" textFill="#3D2E24">
                    <font><Font name="System Bold" size="13.0" /></font>
                </Label>
            </children>
        </HBox>
    </top>

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox prefWidth="210.0" spacing="6.0" style="-fx-background-color: #FFFFFF; -fx-padding: 20 12; -fx-border-color: #EFE8E0; -fx-border-width: 0 1 0 0;">
            <children>
                <Button fx:id="btnDashboard" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" style="-fx-background-color: #F5EBE1; -fx-text-fill: #8B4513; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 14;" text="Dashboard" />
                <Button fx:id="btnStaff" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" style="-fx-background-color: transparent; -fx-text-fill: #7A6A5D; -fx-background-radius: 8; -fx-padding: 10 14;" text="Staff &amp; Users" />
                <Button fx:id="btnProducts" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" style="-fx-background-color: transparent; -fx-text-fill: #7A6A5D; -fx-background-radius: 8; -fx-padding: 10 14;" text="Product Menu" />
                <Button fx:id="btnInventory" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" style="-fx-background-color: transparent; -fx-text-fill: #7A6A5D; -fx-background-radius: 8; -fx-padding: 10 14;" text="Inventory" />
                <Button fx:id="btnSales" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" style="-fx-background-color: transparent; -fx-text-fill: #7A6A5D; -fx-background-radius: 8; -fx-padding: 10 14;" text="Sales &amp; Z-Read" />
                <Region VBox.vgrow="ALWAYS" />
                <Button fx:id="btnLogout" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" style="-fx-background-color: #FDF2F2; -fx-text-fill: #C62828; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 14;" text="Logout" />
            </children>
        </VBox>
    </left>

    <!-- MAIN CONTENT AREA -->
    <center>
        <VBox spacing="20.0" style="-fx-padding: 24;">
            <children>

                <!-- ROW 1: KPI CARDS -->
                <HBox spacing="16.0">
                    <children>
                        <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card">
                            <children>
                                <Label text="TODAY'S SALES" styleClass="kpi-title" />
                                <Label fx:id="lblTodaySales" text="₱14,825.00" styleClass="kpi-value" />
                                <Label text="+12.4% vs yesterday" styleClass="kpi-subtext-green" />
                            </children>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card">
                            <children>
                                <Label text="TRANSACTIONS" styleClass="kpi-title" />
                                <Label fx:id="lblTotalTransactions" text="142 Orders" styleClass="kpi-value" />
                                <Label text="Avg ₱104.40 / order" styleClass="kpi-subtext" />
                            </children>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card">
                            <children>
                                <Label text="TOP SELLER" styleClass="kpi-title" />
                                <Label fx:id="lblTopSeller" text="Spanish Latte" styleClass="kpi-value-accent" />
                                <Label text="68 Cups Sold" styleClass="kpi-subtext" />
                            </children>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card">
                            <children>
                                <Label text="LOW STOCK ALERTS" styleClass="kpi-title" />
                                <Label fx:id="lblLowStock" text="3 Items" styleClass="kpi-value-red" />
                                <Label text="Whole Milk, Oat Milk, Caramel" styleClass="kpi-subtext-red" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <!-- ROW 2: MODERN DATA TABLE CONTAINER -->
                <VBox VBox.vgrow="ALWAYS" styleClass="table-card">
                    <children>
                        <HBox alignment="CENTER_LEFT" style="-fx-padding: 0 0 16 0;">
                            <children>
                                <VBox>
                                    <children>
                                        <Label text="System Audit Logs" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2C1E16;" />
                                        <Label text="Real-time log of security events and manager overrides" style="-fx-font-size: 12px; -fx-text-fill: #9C8C80;" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <!-- Modern Table View -->
                        <TableView fx:id="auditTable" VBox.vgrow="ALWAYS" styleClass="modern-table">
                            <columns>
                                <TableColumn fx:id="colTime" text="TIMESTAMP" prefWidth="140" />
                                <TableColumn fx:id="colUser" text="USER" prefWidth="150" />
                                <TableColumn fx:id="colRole" text="ROLE" prefWidth="120" />
                                <TableColumn fx:id="colAction" text="ACTION" prefWidth="200" />
                                <TableColumn fx:id="colDetails" text="DETAILS" prefWidth="400" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>

            </children>
        </VBox>
    </center>
</BorderPane>