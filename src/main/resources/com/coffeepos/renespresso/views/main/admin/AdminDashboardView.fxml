<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="rootPane" prefHeight="768.0" prefWidth="1280.0"
           style="-fx-background-color: #F3E9DC;"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.coffeepos.renespresso.controller.main.admin.AdminDashboardController">

    <HBox prefHeight="768.0" prefWidth="1280.0">

        <!-- ================= SIDEBAR (same structure as the cashier) ================= -->
        <VBox fx:id="sidebar" minWidth="85.0" prefWidth="85.0" maxWidth="85.0" spacing="8.0" styleClass="user-sidebar">
            <HBox fx:id="brandHeader" alignment="CENTER" maxWidth="Infinity" spacing="10.0">
                <Button onAction="#toggleSidebar" styleClass="brand-button">
                    <graphic>
                        <StackPane minWidth="37.0" minHeight="37.0" prefWidth="37.0" prefHeight="37.0">
                            <Region styleClass="nav-svg, icon-cafe" />
                        </StackPane>
                    </graphic>
                </Button>
                <VBox fx:id="brandTextBox" spacing="1.0">
                    <Label styleClass="brand-name" text="RenEspresso" />
                    <Label styleClass="brand-sub" text="Admin Portal" />
                </VBox>
            </HBox>

            <VBox fx:id="sessionBox" spacing="2.0" styleClass="session-box">
                <Label fx:id="lblClock" styleClass="session-clock" />
                <Label fx:id="lblDate" styleClass="session-date" />
                <Label fx:id="lblUserName" styleClass="session-name" />
            </VBox>

            <Separator styleClass="sidebar-sep" />

            <Button fx:id="btnHome"         maxWidth="Infinity" onAction="#showHome"         styleClass="nav-button" />
            <Button fx:id="btnMenu"         maxWidth="Infinity" onAction="#showMenu"         styleClass="nav-button" />
            <Button fx:id="btnSales"        maxWidth="Infinity" onAction="#showSales"        styleClass="nav-button" />
            <Button fx:id="btnTransactions" maxWidth="Infinity" onAction="#showTransactions" styleClass="nav-button" />
            <Button fx:id="btnAccounts"     maxWidth="Infinity" onAction="#showAccounts"     styleClass="nav-button" />
            <Button fx:id="btnSettings"     maxWidth="Infinity" onAction="#showSettings"     styleClass="nav-button" />

            <Region VBox.vgrow="ALWAYS" />
            <Separator styleClass="sidebar-sep" />
            <Button fx:id="btnLogout" maxWidth="Infinity" onAction="#handleLogout" styleClass="nav-button, nav-logout" />
        </VBox>

        <!-- ================= CONTENT ================= -->
        <StackPane HBox.hgrow="ALWAYS">
            <fx:include fx:id="homeView"        source="home/HomeView.fxml" />
            <fx:include fx:id="menuView"        source="menu/MenuView.fxml" />
            <fx:include fx:id="salesView"       source="sales/SalesView.fxml" />
            <fx:include fx:id="transactionView" source="transact/TransactionView.fxml" />
            <fx:include fx:id="accountsView"    source="account/AccountView.fxml" />
            <fx:include fx:id="settingsView"    source="settings/SettingsView.fxml" />
        </StackPane>
    </HBox>
</StackPane>