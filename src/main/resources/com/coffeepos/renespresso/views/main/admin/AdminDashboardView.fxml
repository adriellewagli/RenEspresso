<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import io.github.palexdev.materialfx.controls.*?>

<StackPane prefHeight="768.0" prefWidth="1280.0"
           style="-fx-background-color: #F3E9DC;"
           stylesheets="@../../styles/admin/dashboard.css"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.coffeepos.renespresso.controller.main.admin.AdminDashboardController">

    <HBox prefHeight="768.0" prefWidth="1280.0">
        <!-- SIDEBAR NAVIGATION -->
        <!-- Update this specific VBox tag and Logo HBox in your FXML -->

        <!-- SIDEBAR NAVIGATION (Starts Minimized at 85px) -->
        <VBox fx:id="sidebar" prefWidth="85.0" spacing="12.0" style="-fx-background-color: #5E3023; -fx-padding: 20 10 20 10; -fx-transition: width 0.2s;">

            <!-- Clickable Logo Header -->
            <HBox alignment="CENTER_LEFT" prefHeight="42.0" spacing="10.0" onMouseClicked="#toggleSidebar" style="-fx-cursor: hand; -fx-padding: 0 5 0 5;">
                <Label style="-fx-text-fill: #F3E9DC; -fx-font-size: 30px; -fx-font-weight: bold;" text="☕" />
                <Label fx:id="lblBrandText" visible="false" managed="false" style="-fx-text-fill: #F3E9DC; -fx-font-size: 24px; -fx-font-weight: bold;" text="RenEspresso" />
            </HBox>

            <Separator style="-fx-opacity: 0.2;" />

            <!-- System Status -->
            <VBox fx:id="userInfoBox" visible="false" managed="false" spacing="4.0" style="-fx-background-color: rgba(243, 233, 220, 0.1); -fx-padding: 10; -fx-background-radius: 8;">
                <HBox alignment="CENTER_LEFT" spacing="6">
                    <Region style="-fx-background-color: #2ECC71; -fx-min-width: 8; -fx-min-height: 8; -fx-max-width: 8; -fx-max-height: 8; -fx-background-radius: 4;" />
                    <Label style="-fx-text-fill: #F3E9DC; -fx-font-size: 12px; -fx-font-weight: bold;" text="ADMIN PORTAL" />
                </HBox>
                <Label style="-fx-text-fill: #F3E9DC; -fx-font-size: 13px; -fx-font-weight: bold;" text="Administrator" />
                <Label fx:id="dateLabel" style="-fx-text-fill: #C08552; -fx-font-size: 12px;" text="Monday, Sep 29, 2026" />
            </VBox>

            <!-- Navigation Menu -->
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                <content>
                    <VBox spacing="8.0" style="-fx-background-color: transparent;">
                        <!-- Using styleClass instead of inline styles -->
                        <Button fx:id="btnHome" styleClass="nav-button" alignment="CENTER" maxWidth="Infinity" onAction="#showHome" text="🏠">
                            <tooltip><Tooltip text="Home" /></tooltip>
                        </Button>
                        <Button fx:id="btnMenu" styleClass="nav-button" alignment="CENTER" maxWidth="Infinity" onAction="#showMenu" text="📋">
                            <tooltip><Tooltip text="Menu Management" /></tooltip>
                        </Button>
                        <Button fx:id="btnSales" styleClass="nav-button" alignment="CENTER" maxWidth="Infinity" onAction="#showSales" text="📈">
                            <tooltip><Tooltip text="Sales" /></tooltip>
                        </Button>
                        <Button fx:id="btnTransactions" styleClass="nav-button" alignment="CENTER" maxWidth="Infinity" onAction="#showTransactions" text="🕒">
                            <tooltip><Tooltip text="Transaction History" /></tooltip>
                        </Button>
                        <Button fx:id="btnAccounts" styleClass="nav-button" alignment="CENTER" maxWidth="Infinity" onAction="#showAccounts" text="👥">
                            <tooltip><Tooltip text="Account Management" /></tooltip>
                        </Button>
                        <Button fx:id="btnSettings" styleClass="nav-button" alignment="CENTER" maxWidth="Infinity" onAction="#showSettings" text="⚙️">
                            <tooltip><Tooltip text="Settings" /></tooltip>
                        </Button>
                    </VBox>
                </content>
            </ScrollPane>

            <Separator style="-fx-opacity: 0.2;" />

            <!-- Logout Button -->
            <MFXButton fx:id="btnLogout" styleClass="logout-button" alignment="CENTER" maxWidth="Infinity" onAction="#handleLogout" text="🚪">
                <tooltip><Tooltip text="Logout" /></tooltip>
            </MFXButton>
        </VBox>

        <!-- CONTENT AREA -->
        <StackPane HBox.hgrow="ALWAYS">
            <!-- (Your existing ScrollPane/VBox Views go here completely unchanged) -->
            <ScrollPane fx:id="homeView" fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" visible="true">
                <content>
                    <VBox spacing="20.0" style="-fx-padding: 30;">
                        <VBox spacing="4.0">
                            <Label style="-fx-text-fill: #5E3023; -fx-font-size: 28px; -fx-font-weight: bold;" text="Home Dashboard" />
                            <Label style="-fx-text-fill: #895737; -fx-font-size: 15px;" text="Overview of store sales health and operational diagnostics" />
                        </VBox>
                    </VBox>
                </content>
            </ScrollPane>
            <!-- (Add the remaining menuView, salesView, etc. just like you had them) -->
        </StackPane>
    </HBox>
</StackPane>