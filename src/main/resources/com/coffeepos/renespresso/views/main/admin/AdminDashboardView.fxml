<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import io.github.palexdev.materialfx.controls.*?>

<StackPane prefHeight="768.0" prefWidth="1280.0"
           style="-fx-background-color: #F3E9DC;"
           stylesheets="@../../styles/admin/dashboard.css"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.coffeepos.renespresso.controller.main.admin.AdminDashboardController">

    <HBox prefHeight="768.0" prefWidth="1280.0">

        <!-- SIDEBAR NAVIGATION (starts minimized at 85px) -->
        <VBox fx:id="sidebar" prefWidth="85.0" spacing="12.0" style="-fx-background-color: #5E3023; -fx-padding: 20 10 20 10;">

            <HBox alignment="CENTER" prefHeight="42.0" minHeight="42.0" spacing="8.0" onMouseClicked="#toggleSidebar" style="-fx-cursor: hand;">
                <Label alignment="CENTER" style="-fx-text-fill: #F3E9DC; -fx-font-size: 28px;" text="☕" />
                <Label fx:id="lblBrandText" visible="false" managed="false" style="-fx-text-fill: #F3E9DC; -fx-font-size: 22px; -fx-font-weight: bold;" text="RenEspresso" />
            </HBox>

            <Separator style="-fx-opacity: 0.2;" />

            <!-- System Status -->
            <VBox fx:id="userInfoBox" visible="false" managed="false" spacing="4.0" style="-fx-background-color: rgba(243, 233, 220, 0.1); -fx-padding: 10; -fx-background-radius: 8;">
                <HBox alignment="CENTER_LEFT" spacing="6">
                    <Region style="-fx-background-color: #2ECC71; -fx-min-width: 8; -fx-min-height: 8; -fx-max-width: 8; -fx-max-height: 8; -fx-background-radius: 4;" />
                    <Label style="-fx-text-fill: #F3E9DC; -fx-font-size: 12px; -fx-font-weight: bold;" text="ADMIN PORTAL" />
                </HBox>
                <Label style="-fx-text-fill: #F3E9DC; -fx-font-size: 13px; -fx-font-weight: bold;" text="Administrator" />
                <Label fx:id="dateLabel" style="-fx-text-fill: #C08552; -fx-font-size: 12px;" text="Monday, Sep 29, 2026" />
            </VBox>

            <!-- Navigation Menu -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="NEVER"
                        style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 0;"
                        VBox.vgrow="ALWAYS">
                <content>
                    <VBox spacing="8.0" style="-fx-background-color: transparent;">
                        <Button fx:id="btnHome" styleClass="nav-button" alignment="CENTER" maxWidth="Infinity" onAction="#showHome" text="🏠">
                            <tooltip><Tooltip text="Home" /></tooltip>
                        </Button>
                        <Button fx:id="btnMenu" styleClass="nav-button" alignment="CENTER" maxWidth="Infinity" onAction="#showMenu" text="📋">
                            <tooltip><Tooltip text="Menu Management" /></tooltip>
                        </Button>
                        <Button fx:id="btnSales" styleClass="nav-button" alignment="CENTER" maxWidth="Infinity" onAction="#showSales" text="📈">
                            <tooltip><Tooltip text="Sales" /></tooltip>
                        </Button>
                        <Button fx:id="btnTransactions" styleClass="nav-button" alignment="CENTER" maxWidth="Infinity" onAction="#showTransactions" text="🕒">
                            <tooltip><Tooltip text="Transaction History" /></tooltip>
                        </Button>
                        <Button fx:id="btnAccounts" styleClass="nav-button" alignment="CENTER" maxWidth="Infinity" onAction="#showAccounts" text="👥">
                            <tooltip><Tooltip text="Account Management" /></tooltip>
                        </Button>
                        <Button fx:id="btnSettings" styleClass="nav-button" alignment="CENTER" maxWidth="Infinity" onAction="#showSettings" text="🔧">
                            <tooltip><Tooltip text="Settings" /></tooltip>
                        </Button>
                    </VBox>
                </content>
            </ScrollPane>

            <Separator style="-fx-opacity: 0.2;" />

            <!-- Logout Button -->
            <MFXButton fx:id="btnLogout" styleClass="logout-button" alignment="CENTER" maxWidth="Infinity" onAction="#handleLogout" text="🚪">
                <tooltip><Tooltip text="Logout" /></tooltip>
            </MFXButton>
        </VBox>

        <!-- CONTENT AREA: each section lives in its own FXML -->
        <StackPane HBox.hgrow="ALWAYS">
            <fx:include fx:id="homeView"        source="home/HomeView.fxml" />
            <fx:include fx:id="menuView"        source="menu/MenuView.fxml" />
            <fx:include fx:id="salesView"       source="sales/SalesView.fxml" />
            <fx:include fx:id="transactionView" source="transact/TransactionView.fxml" />
            <fx:include fx:id="accountsView"    source="account/AccountView.fxml" />

            <!-- Settings placeholder (move to its own folder when you build it) -->
            <VBox fx:id="settingsView" visible="false" managed="false" spacing="20.0" style="-fx-padding: 30;">
                <Label style="-fx-text-fill: #5E3023; -fx-font-size: 28px; -fx-font-weight: bold;" text="Settings" />
                <Label style="-fx-text-fill: #895737; -fx-font-size: 15px;" text="Application preferences and configuration" />

                <VBox alignment="CENTER_LEFT" maxWidth="640" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 18;">
                    <Label text="Store information coming soon" style="-fx-text-fill: #C08552; -fx-font-size: 14;" />
                </VBox>
                <VBox alignment="CENTER_LEFT" maxWidth="640" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 18;">
                    <Label text="Receipt settings coming soon" style="-fx-text-fill: #C08552; -fx-font-size: 14;" />
                </VBox>
                <VBox alignment="CENTER_LEFT" maxWidth="640" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 18;">
                    <Label text="Security settings coming soon" style="-fx-text-fill: #C08552; -fx-font-size: 14;" />
                </VBox>
            </VBox>
        </StackPane>
    </HBox>
</StackPane>