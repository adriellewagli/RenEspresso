<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="posRoot"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.coffeepos.renespresso.controller.main.user.pos.PosController">

    <HBox>
        <!-- ================= MENU ================= -->
        <VBox spacing="20.0" styleClass="view-container" HBox.hgrow="ALWAYS">
            <VBox spacing="4.0" styleClass="page-header">
                <Label styleClass="page-title" text="Menu" />
                <Label styleClass="page-subtitle" text="Tap a size to add the item to the current order" />
            </VBox>

            <VBox spacing="14.0" styleClass="card, toolbar-card">
                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="search-box">
                    <Region styleClass="icon-search" />
                    <TextField fx:id="txtMenuSearch" promptText="Search dishes or categories…"
                               styleClass="search-field" HBox.hgrow="ALWAYS" />
                </HBox>
                <FlowPane fx:id="categoryBar" hgap="8.0" vgap="8.0" />
            </VBox>

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="transparent-scrollpane" VBox.vgrow="ALWAYS">
                <content>
                    <FlowPane fx:id="menuGrid" hgap="18.0" vgap="22.0" styleClass="dish-grid" />
                </content>
            </ScrollPane>
        </VBox>

        <!-- ================= CURRENT ORDER ================= -->
        <VBox minWidth="380.0" prefWidth="380.0" maxWidth="380.0" spacing="14.0" styleClass="order-sidebar">
            <VBox spacing="2.0">
                <Label styleClass="cart-header-title" text="Current Order" />
                <Label fx:id="lblCartTicket" styleClass="cart-ticket-subtext" />
            </VBox>

            <ListView fx:id="cartListView" styleClass="transparent-listview" VBox.vgrow="ALWAYS" />

            <VBox spacing="6.0" styleClass="discount-banner">
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <CheckBox fx:id="chkDiscount" onAction="#handleDiscountToggle" styleClass="discount-checkbox"
                              text="Senior / PWD discount" />
                    <Region HBox.hgrow="ALWAYS" />
                    <HBox fx:id="boxSeniorCount" alignment="CENTER" spacing="4.0" managed="false" visible="false">
                        <Label styleClass="discount-tag" text="IDs:" />
                        <Button fx:id="btnSeniorMinus" onAction="#handleSeniorMinus" styleClass="qty-btn" text="−" />
                        <Label fx:id="lblSeniorCount" alignment="CENTER" minWidth="18.0" styleClass="cart-item-title" text="1" />
                        <Button fx:id="btnSeniorPlus" onAction="#handleSeniorPlus" styleClass="qty-btn" text="+" />
                    </HBox>
                </HBox>
                <Label fx:id="lblSeniorNote" managed="false" styleClass="discount-tag" text="Applies 20% + VAT-exempt to highest-priced meal" visible="false" />
            </VBox>

            <VBox spacing="8.0" styleClass="totals-box">
                <Separator styleClass="totals-separator" />
                <HBox>
                    <Label styleClass="total-label-muted" text="VATable Sales" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblSubtotal" styleClass="total-value-dark" text="₱0.00" />
                </HBox>
                <HBox>
                    <Label styleClass="total-label-muted" text="VAT (12%)" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblVat" styleClass="total-value-dark" text="₱0.00" />
                </HBox>
                <HBox fx:id="rowDiscount" managed="false" visible="false">
                    <Label fx:id="lblDiscountTitle" styleClass="total-label-accent" text="Senior/PWD (20%)" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblDiscount" styleClass="total-value-accent" text="-₱0.00" />
                </HBox>
                <HBox alignment="CENTER_LEFT">
                    <Label styleClass="total-grand-label" text="Total" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblTotal" styleClass="total-grand-value" text="₱0.00" />
                </HBox>
            </VBox>

            <HBox spacing="10.0">
                <Button maxWidth="Infinity" onAction="#handleClearCart" styleClass="btn-secondary" text="Clear" HBox.hgrow="SOMETIMES" />
                <Button maxWidth="Infinity" onAction="#openConfirmationModal" styleClass="btn-primary" text="Charge" HBox.hgrow="ALWAYS" />
            </HBox>
        </VBox>
    </HBox>

    <!-- ================= PAYMENT MODAL ================= -->
    <StackPane fx:id="modalOverlay" styleClass="modal-overlay" visible="false">
        <VBox maxHeight="-Infinity" maxWidth="460.0" spacing="14.0" styleClass="modal-dialog">
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label styleClass="modal-title" text="Confirm Payment" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblModalTicket" styleClass="modal-ticket-badge" />
            </HBox>

            <VBox alignment="CENTER_LEFT" spacing="2.0" styleClass="modal-amount-box">
                <Label styleClass="modal-amount-label" text="Amount due" />
                <Label fx:id="lblModalTotal" styleClass="modal-amount-value, modal-total-amount" />
            </VBox>

            <VBox fx:id="rowCashBox" spacing="10.0">
                <HBox fx:id="rowCash" alignment="CENTER_LEFT" spacing="10.0">
                    <Label styleClass="field-label" text="Cash received" />
                    <TextField fx:id="txtCashReceived" promptText="0.00" HBox.hgrow="ALWAYS" />
                </HBox>
                <HBox fx:id="quickCashBar" spacing="8.0">
                    <Button onAction="#handleQuickCash" styleClass="btn-secondary-sm" text="Exact" />
                    <Button onAction="#handleQuickCash" styleClass="btn-secondary-sm" text="₱100" />
                    <Button onAction="#handleQuickCash" styleClass="btn-secondary-sm" text="₱200" />
                    <Button onAction="#handleQuickCash" styleClass="btn-secondary-sm" text="₱500" />
                    <Button onAction="#handleQuickCash" styleClass="btn-secondary-sm" text="₱1000" />
                </HBox>
                <HBox fx:id="rowChange" alignment="CENTER_LEFT">
                    <Label styleClass="modal-body-text" text="Change" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblChange" styleClass="modal-amount-value" text="₱0.00" />
                </HBox>
            </VBox>

            <HBox alignment="CENTER_RIGHT" spacing="10.0">
                <Button onAction="#closeConfirmationModal" styleClass="btn-secondary" text="Cancel" />
                <Button fx:id="btnConfirmOrder" onAction="#confirmAndFinalizeOrder" styleClass="btn-primary" text="Confirm Order" />
            </HBox>
        </VBox>
    </StackPane>
</StackPane>
