<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- NOTE: adjust the fx:include "source" paths to where your included FXMLs live. -->
<StackPane fx:id="rootPane" styleClass="user-root"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.coffeepos.renespresso.controller.main.user.UserViewController">
    <HBox>

        <!-- ================= SIDEBAR ================= -->
        <VBox fx:id="sidebar" minWidth="85.0" prefWidth="85.0" maxWidth="85.0" spacing="8.0" styleClass="user-sidebar">
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Button onAction="#toggleSidebar" styleClass="brand-button">
                    <graphic><Region styleClass="nav-svg, icon-cafe" /></graphic>
                </Button>
                <VBox fx:id="brandTextBox" spacing="1.0">
                    <Label styleClass="brand-name" text="RenEspresso" />
                    <Label styleClass="brand-sub" text="Cashier Terminal" />
                </VBox>
            </HBox>

            <VBox fx:id="sessionBox" spacing="2.0" styleClass="session-box">
                <Label fx:id="lblClock" styleClass="session-clock" />
                <Label fx:id="lblDate" styleClass="session-date" />
                <Label fx:id="lblCashierName" styleClass="session-name" />
            </VBox>

            <Separator styleClass="sidebar-sep" />

            <Button fx:id="btnHome" maxWidth="Infinity" onAction="#showHome" styleClass="nav-button" />
            <Button fx:id="btnMenu" maxWidth="Infinity" onAction="#showMenu" styleClass="nav-button" />
            <Button fx:id="btnOrders" maxWidth="Infinity" onAction="#showOrders" styleClass="nav-button" />

            <Region VBox.vgrow="ALWAYS" />
            <Separator styleClass="sidebar-sep" />
            <Button fx:id="btnLogout" maxWidth="Infinity" onAction="#handleLogout" styleClass="nav-button, nav-logout" />
        </VBox>

        <!-- ================= CONTENT ================= -->
        <StackPane HBox.hgrow="ALWAYS" styleClass="content-area">

            <!-- HOME -->
            <VBox fx:id="homeView" spacing="20.0" styleClass="view-container">
                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="page-header">
                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                        <Label styleClass="page-title" text="Home" />
                        <Label fx:id="lblWelcome" styleClass="page-subtitle" />
                    </VBox>
                    <Button onAction="#showMenu" styleClass="btn-primary" text="+  New Order" />
                </HBox>

                <!-- KPI CARDS -->
                <HBox spacing="16.0">
                    <VBox styleClass="card, kpi-card" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                        <Label styleClass="kpi-title" text="TODAY'S SALES" />
                        <Label fx:id="lblDashSales" styleClass="kpi-value" text="—" />
                        <Label fx:id="lblDashLast" styleClass="kpi-sub" text=" " />
                    </VBox>
                    <VBox styleClass="card, kpi-card" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                        <Label styleClass="kpi-title" text="ORDERS TODAY" />
                        <Label fx:id="lblDashOrders" styleClass="kpi-value" text="—" />
                        <Label fx:id="lblDashItems" styleClass="kpi-sub" text=" " />
                    </VBox>
                    <VBox styleClass="card, kpi-card" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                        <Label styleClass="kpi-title" text="IN QUEUE" />
                        <Label fx:id="lblDashQueue" styleClass="kpi-value" text="—" />
                        <Label styleClass="kpi-sub" text="Orders being prepared" />
                    </VBox>
                    <VBox styleClass="card, kpi-card" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                        <Label styleClass="kpi-title" text="NEXT TICKET" />
                        <Label fx:id="lblDashNextTicket" styleClass="kpi-value" text="—" />
                        <Label fx:id="lblDashAvg" styleClass="kpi-sub" text=" " />
                    </VBox>
                </HBox>

                <!-- QUEUE + RECENT (share the leftover height, no page scrollbar) -->
                <HBox spacing="16.0" minHeight="0.0" prefHeight="0.0" VBox.vgrow="ALWAYS">
                    <VBox styleClass="card, panel-card" minHeight="0.0" prefWidth="560.0" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                <Label styleClass="card-title" text="Order Queue" />
                                <Label fx:id="lblQueueCount" styleClass="card-subtitle" />
                            </VBox>
                            <Button onAction="#showOrders" styleClass="btn-secondary-sm" text="View all" />
                        </HBox>
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" minHeight="0.0" prefHeight="0.0"
                                    styleClass="transparent-scrollpane" VBox.vgrow="ALWAYS">
                            <content>
                                <VBox fx:id="queueBox" spacing="10.0" styleClass="list-box" />
                            </content>
                        </ScrollPane>
                    </VBox>

                    <VBox styleClass="card, panel-card" minHeight="0.0" minWidth="300.0" prefWidth="340.0">
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                <Label styleClass="card-title" text="Recent Orders" />
                                <Label fx:id="lblDashDiscounted" styleClass="card-subtitle" />
                            </VBox>
                        </HBox>
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" minHeight="0.0" prefHeight="0.0"
                                    styleClass="transparent-scrollpane" VBox.vgrow="ALWAYS">
                            <content>
                                <VBox fx:id="recentOrdersBox" spacing="14.0" styleClass="list-box" />
                            </content>
                        </ScrollPane>
                    </VBox>
                </HBox>
            </VBox>


            <fx:include fx:id="posView" source="pos/PosView.fxml" />
            <fx:include fx:id="queueView" source="queue/OrderQueueView.fxml" />
            <fx:include fx:id="orderView" source="om/OrderManagementView.fxml" />


        </StackPane>
    </HBox>
</StackPane>
