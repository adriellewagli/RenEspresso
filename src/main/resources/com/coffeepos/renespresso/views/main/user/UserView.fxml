<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="rootPane" prefHeight="768.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.coffeepos.renespresso.controller.main.user.UserViewController">

    <!-- MAIN APP CONTAINER -->
    <HBox prefHeight="768.0" prefWidth="1280.0">

        <!-- MODERN SIDEBAR NAVIGATION -->
        <VBox prefWidth="260.0" spacing="16.0" styleClass="sidebar">

            <!-- Brand Logo Header -->
            <HBox alignment="CENTER_LEFT" prefHeight="48.0" spacing="12.0">
                <StackPane prefHeight="36.0" prefWidth="36.0" styleClass="brand-icon-box">
                    <Label styleClass="brand-icon-text" text="☕" />
                </StackPane>
                <VBox alignment="CENTER_LEFT" spacing="1">
                    <Label styleClass="brand-title" text="RenEspresso" />
                    <Label styleClass="brand-subtitle" text="POS SYSTEM" />
                </VBox>
            </HBox>

            <Separator styleClass="sidebar-separator" />

            <!-- Cashier Session Information Box -->
            <VBox spacing="6.0" styleClass="session-box">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Region styleClass="status-dot" />
                    <Label styleClass="status-text" text="SYSTEM ONLINE" />
                </HBox>
                <Label styleClass="cashier-text" text="Cashier — Rina" />
                <Label fx:id="lblClock" styleClass="clock-text" text="03:52 PM" />
            </VBox>

            <!-- Navigation Bar -->
            <VBox spacing="6.0" VBox.vgrow="ALWAYS">
                <Button fx:id="btnHome" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#showHome" styleClass="nav-button-active" text="🏠  Home" />
                <Button fx:id="btnMenu" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#showMenu" styleClass="nav-button" text="📋  Menu" />
                <Button fx:id="btnTransactionHistory" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#showTransactionHistory" styleClass="nav-button" text="📜  Transaction History" />
                <Button fx:id="btnAbout" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#showAbout" styleClass="nav-button" text="ℹ  About" />
                <Button fx:id="btnSettings" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#showSettings" styleClass="nav-button" text="⚙  Settings" />
            </VBox>

            <Separator styleClass="sidebar-separator" />

            <!-- Logout Button -->
            <Button fx:id="btnLogout" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#handleLogout" styleClass="logout-button" text="🚪  Logout" />
        </VBox>

        <!-- CONTENT AREA VIEW STACK -->
        <StackPane HBox.hgrow="ALWAYS">

            <!-- VIEW 1: HOME DASHBOARD -->
            <VBox fx:id="homeView" spacing="24.0" styleClass="view-container">
                <!-- Header -->
                <VBox spacing="4.0">
                    <Label styleClass="page-title" text="Welcome back, Cashier Rina 👋" />
                    <Label styleClass="page-subtitle" text="Here is your real-time performance summary for this shift." />
                </VBox>

                <!-- Metric Cards Grid -->
                <HBox spacing="20.0">
                    <VBox prefWidth="310.0" spacing="10.0" styleClass="dashboard-card">
                        <Label styleClass="card-title" text="SESSION SALES" />
                        <Label fx:id="lblDashSales" styleClass="card-metric-green" text="₱0.00" />
                        <Label styleClass="card-subtext" text="Total from finalized orders" />
                    </VBox>

                    <VBox prefWidth="310.0" spacing="10.0" styleClass="dashboard-card">
                        <Label styleClass="card-title" text="ORDERS THIS SESSION" />
                        <Label fx:id="lblDashOrders" styleClass="card-metric-dark" text="0" />
                        <Label styleClass="card-subtext" text="Completed transactions" />
                    </VBox>

                    <VBox prefWidth="310.0" spacing="10.0" styleClass="dashboard-card">
                        <Label styleClass="card-title" text="NEXT TICKET NUMBER" />
                        <Label fx:id="lblDashNextTicket" styleClass="card-metric-accent" text="#042" />
                        <Label styleClass="card-subtext" text="Assigned upon order setup" />
                    </VBox>
                </HBox>

                <!-- Quick Actions & Shift Info Section -->
                <HBox spacing="20.0" VBox.vgrow="ALWAYS">
                    <VBox prefWidth="400.0" spacing="16.0" styleClass="dashboard-card" HBox.hgrow="ALWAYS">
                        <Label styleClass="section-header-title" text="Quick Actions" />
                        <HBox spacing="12.0">
                            <Button onAction="#showMenu" styleClass="btn-primary" text="➕  Create New Order" />
                            <Button onAction="#showTransactionHistory" styleClass="btn-secondary" text="📜  View History" />
                        </HBox>
                        <Separator styleClass="light-separator" />
                        <VBox spacing="8.0">
                            <Label styleClass="section-subheader-title" text="Active Shift Summary" />
                            <Label styleClass="card-subtext" text="• Terminal ID: REG-01 (Counter 1)" />
                            <Label styleClass="card-subtext" text="• Senior/PWD Discounts: Auto-calculated" />
                            <Label styleClass="card-subtext" text="• Default Printer: Thermal Receipt POS-80" />
                        </VBox>
                    </VBox>
                </HBox>
            </VBox>

            <!-- VIEW 2: MENU (POS ORDER SCREEN) -->
            <HBox fx:id="menuView" visible="false">
                <VBox spacing="18.0" styleClass="menu-container" HBox.hgrow="ALWAYS">
                    <HBox spacing="8.0">
                        <Button onAction="#filterCategory" styleClass="category-btn-active" text="All" />
                        <Button onAction="#filterCategory" styleClass="category-btn" text="Hot Coffee" />
                        <Button onAction="#filterCategory" styleClass="category-btn" text="Iced Coffee" />
                        <Button onAction="#filterCategory" styleClass="category-btn" text="Milk Tea" />
                        <Button onAction="#filterCategory" styleClass="category-btn" text="Pastries" />
                    </HBox>

                    <ScrollPane fitToWidth="true" styleClass="transparent-scrollpane" VBox.vgrow="ALWAYS">
                        <GridPane fx:id="menuGrid" hgap="16.0" vgap="16.0" />
                    </ScrollPane>
                </VBox>

                <!-- Order Sidebar -->
                <VBox prefWidth="380.0" spacing="14.0" styleClass="order-sidebar">
                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="2">
                            <Label styleClass="cart-header-title" text="Current Order" />
                            <Label fx:id="lblCartTicket" styleClass="cart-ticket-subtext" text="will be ticket #042" />
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                    </HBox>

                    <Separator styleClass="light-separator" />
                    <ListView fx:id="cartListView" styleClass="transparent-listview" VBox.vgrow="ALWAYS" />
                    <Separator styleClass="light-separator" />

                    <HBox alignment="CENTER_LEFT" styleClass="discount-banner">
                        <CheckBox fx:id="chkDiscount" onAction="#handleDiscountToggle" styleClass="discount-checkbox" text="Senior / PWD Discount" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label styleClass="discount-tag" text="-20% + VAT Exemption" />
                    </HBox>

                    <VBox spacing="8.0" styleClass="totals-box">
                        <HBox>
                            <Label styleClass="total-label-muted" text="Subtotal" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="lblSubtotal" styleClass="total-value-dark-bold" text="₱0.00" />
                        </HBox>
                        <HBox>
                            <Label styleClass="total-label-muted" text="VAT (12%)" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="lblVat" styleClass="total-value-dark" text="₱0.00" />
                        </HBox>
                        <HBox fx:id="rowDiscount" visible="false">
                            <Label styleClass="total-label-accent" text="Discount Applied" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="lblDiscount" styleClass="total-value-accent" text="-₱0.00" />
                        </HBox>
                        <Separator styleClass="totals-separator" />
                        <HBox alignment="CENTER_LEFT">
                            <Label styleClass="total-grand-label" text="Total" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="lblTotal" styleClass="total-grand-value" text="₱0.00" />
                        </HBox>
                    </VBox>

                    <Button maxWidth="Infinity" onAction="#openConfirmationModal" styleClass="btn-accent" text="Finalize Order &amp; Print Receipt" />
                </VBox>
            </HBox>

            <!-- VIEW 3: TRANSACTION HISTORY -->
            <VBox fx:id="historyView" spacing="16.0" styleClass="view-container" visible="false">
                <VBox spacing="4.0">
                    <Label styleClass="page-title" text="Transaction History" />
                    <Label styleClass="page-subtitle" text="Recent transactions for this active cashier session." />
                </VBox>

                <!-- Outer Card Wrapper to match Admin Dashboard layout -->
                <VBox styleClass="dashboard-card" VBox.vgrow="ALWAYS" style="-fx-padding: 20px;">
                    <TableView fx:id="tblHistory" styleClass="modern-audit-table" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn prefWidth="140.0" text="TICKET #" />
                            <TableColumn prefWidth="140.0" text="TIME" />
                            <TableColumn prefWidth="320.0" text="ITEMS" />
                            <TableColumn prefWidth="180.0" text="DISCOUNT APPLIED" />
                            <TableColumn prefWidth="160.0" text="TOTAL PAID" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                </VBox>
            </VBox>

            <!-- VIEW 4: ABOUT -->
            <VBox fx:id="aboutView" spacing="20.0" styleClass="view-container" visible="false">
                <!-- Page Header -->
                <VBox spacing="4.0">
                    <Label styleClass="page-title" text="About RenEspresso POS" />
                    <Label styleClass="page-subtitle" text="System information, version details, and developer documentation." />
                </VBox>

                <!-- Hero Card -->
                <VBox spacing="10.0" styleClass="dashboard-card">
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <StackPane prefHeight="40.0" prefWidth="40.0" styleClass="brand-icon-box">
                            <Label styleClass="brand-icon-text" text="☕" />
                        </StackPane>
                        <VBox spacing="2">
                            <Label styleClass="about-hero-title" text="RenEspresso Point of Sale System" />
                            <Label styleClass="about-hero-version" text="Version 1.0.0 (Build 2026.09)" />
                        </VBox>
                    </HBox>
                    <Separator styleClass="light-separator" />
                    <Label styleClass="card-subtext" text="A specialized JavaFX counter management solution designed for coffee shop order processing, real-time ticket queueing, and receipt printing." wrapText="true" />
                </VBox>

                <!-- Information Grid -->
                <HBox spacing="20.0">
                    <!-- Column 1: System Environment -->
                    <VBox prefWidth="450.0" spacing="12.0" styleClass="dashboard-card" HBox.hgrow="ALWAYS">
                        <Label styleClass="section-header-title" text="💻 System Environment" />
                        <Separator styleClass="light-separator" />
                        <VBox spacing="8.0">
                            <HBox>
                                <Label styleClass="card-subtext" text="Framework:" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label styleClass="about-item-bold" text="JavaFX 21 (JDK 21)" />
                            </HBox>
                            <HBox>
                                <Label styleClass="card-subtext" text="Database:" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label styleClass="about-item-bold" text="SQLite 3.42 (Local Embedded)" />
                            </HBox>
                            <HBox>
                                <Label styleClass="card-subtext" text="Terminal Assigned:" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label styleClass="about-item-bold" text="Counter #1 (REG-01)" />
                            </HBox>
                            <HBox>
                                <Label styleClass="card-subtext" text="Default Printer:" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label styleClass="about-item-bold" text="Thermal Receipt POS-80" />
                            </HBox>
                        </VBox>
                    </VBox>

                    <!-- Column 2: Core Features -->
                    <VBox prefWidth="450.0" spacing="12.0" styleClass="dashboard-card" HBox.hgrow="ALWAYS">
                        <Label styleClass="section-header-title" text="⚡ Key Features" />
                        <Separator styleClass="light-separator" />
                        <VBox spacing="6.0">
                            <Label styleClass="card-subtext" text="• Dynamic menu navigation &amp; categorized product filtering" />
                            <Label styleClass="card-subtext" text="• Automated Senior Citizen / PWD 20% discount &amp; VAT exemption" />
                            <Label styleClass="card-subtext" text="• Real-time ticket numbering sequence and order auditing" />
                            <Label styleClass="card-subtext" text="• Cashier shift session tracking and historical transaction table" />
                        </VBox>
                    </VBox>
                </HBox>

                <!-- Footer Support Card -->
                <VBox spacing="10.0" styleClass="dashboard-card">
                    <Label styleClass="section-header-title" text="👥 Credits &amp; System Support" />
                    <Separator styleClass="light-separator" />
                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="4.0">
                            <Label styleClass="card-subtext" text="Developed for RenEspresso Coffee Shop Operations." />
                            <Label styleClass="about-copyright-text" text="© 2026 RenEspresso POS System. All Rights Reserved." />
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button styleClass="btn-secondary" text="📞 Contact System Administrator" />
                    </HBox>
                </VBox>
            </VBox>

            <!-- VIEW 5: SETTINGS -->
            <VBox fx:id="settingsView" spacing="20.0" styleClass="view-container" visible="false">
                <!-- Page Header -->
                <VBox spacing="4.0">
                    <Label styleClass="page-title" text="Settings" />
                    <Label styleClass="page-subtitle" text="Configure hardware peripherals, checkout preferences, and local terminal behaviors." />
                </VBox>

                <ScrollPane fitToWidth="true" styleClass="transparent-scrollpane" VBox.vgrow="ALWAYS">
                    <VBox spacing="20.0">

                        <!-- Section 1: Printer & Hardware Settings -->
                        <VBox spacing="14.0" styleClass="dashboard-card">
                            <Label styleClass="section-header-title" text="🖨️ Printer &amp; Hardware Configuration" />
                            <Separator styleClass="light-separator" />

                            <GridPane hgap="20.0" vgap="14.0">
                                <columnConstraints>
                                    <ColumnConstraints prefWidth="220.0" />
                                    <ColumnConstraints hgrow="ALWAYS" />
                                </columnConstraints>

                                <!-- Active Printer Selection -->
                                <Label styleClass="card-subtext" text="Target Printer:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                <ComboBox maxWidth="300.0" promptText="Select Thermal Printer..." styleClass="btn-secondary" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                <!-- Receipt Paper Size -->
                                <Label styleClass="card-subtext" text="Paper Roll Width:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                <HBox spacing="12.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                    <RadioButton selected="true" styleClass="settings-checkbox" text="80mm Thermal Paper (Standard)" />
                                    <RadioButton styleClass="settings-checkbox" text="58mm Small Roll" />
                                </HBox>

                                <!-- Checkbox Controls -->
                                <VBox spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                    <CheckBox selected="true" styleClass="settings-checkbox" text="Auto-print receipt immediately after order finalization" />
                                    <CheckBox selected="true" styleClass="settings-checkbox" text="Pop open cash drawer electronically upon payment" />
                                    <CheckBox styleClass="settings-checkbox" text="Print dual receipt copies (Customer + Merchant Copy)" />
                                </VBox>
                            </GridPane>
                        </VBox>

                        <!-- Section 2: Checkout & Order Preferences -->
                        <VBox spacing="14.0" styleClass="dashboard-card">
                            <Label styleClass="section-header-title" text="🛒 Checkout &amp; Order Behavior" />
                            <Separator styleClass="light-separator" />

                            <VBox spacing="12.0">
                                <CheckBox selected="true" styleClass="settings-checkbox" text="Play audio chime when items are added/removed from cart" />
                                <CheckBox selected="true" styleClass="settings-checkbox" text="Require confirmation dialog before finalizing orders" />
                                <CheckBox selected="true" styleClass="settings-checkbox" text="Automatically clear Senior/PWD discount state for next order" />

                                <HBox alignment="CENTER_LEFT" spacing="16.0" style="-fx-padding: 6 0 0 0;">
                                    <Label styleClass="card-subtext" text="Default Payment Method:" />
                                    <ComboBox maxWidth="200.0" promptText="Cash" styleClass="btn-secondary" />
                                </HBox>
                            </VBox>
                        </VBox>

                        <!-- Section 3: Data & Terminal Maintenance -->
                        <VBox spacing="14.0" styleClass="dashboard-card">
                            <Label styleClass="section-header-title" text="💾 System &amp; Local Database Maintenance" />
                            <Separator styleClass="light-separator" />

                            <HBox alignment="CENTER_LEFT" spacing="16.0">
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                    <Label styleClass="section-subheader-title" text="Backup POS Database" />
                                    <Label styleClass="card-subtext" text="Generate a local SQL/SQLite backup file containing sales history and product catalog." />
                                </VBox>
                                <Button styleClass="btn-secondary" text="📦 Backup Database Now" />
                            </HBox>

                            <Separator styleClass="light-separator" />

                            <HBox alignment="CENTER_LEFT" spacing="16.0">
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                    <Label styleClass="section-subheader-title" text="Reset Ticket Sequence" />
                                    <Label styleClass="card-subtext" text="Reset order queue counter back to #001 for a new operational shift day." />
                                </VBox>
                                <Button styleClass="btn-secondary" text="🔄 Reset Queue Counter" />
                            </HBox>
                        </VBox>

                        <!-- Save Settings Bar -->
                        <HBox alignment="CENTER_RIGHT" spacing="12.0">
                            <Button styleClass="btn-secondary" text="Reset Defaults" />
                            <Button styleClass="btn-primary" text="💾 Save Preference Changes" />
                        </HBox>

                    </VBox>
                </ScrollPane>
            </VBox>

        </StackPane>
    </HBox>

    <!-- MODERN MODAL OVERLAY -->
    <StackPane fx:id="modalOverlay" styleClass="modal-overlay" visible="false">
        <VBox alignment="CENTER" fillWidth="false" maxWidth="420.0" spacing="18.0" styleClass="modal-dialog">
            <Label styleClass="modal-title" text="Confirm Order Finalization" />
            <Label fx:id="lblModalTicket" styleClass="modal-ticket-badge" text="Ticket #042" />
            <Label styleClass="modal-body-text" text="Are you sure you want to finalize this order and process the payment?" wrapText="true" />
            <HBox spacing="8.0" styleClass="modal-amount-box">
                <Label styleClass="modal-amount-label" text="Total Amount Due:" />
                <Label fx:id="lblModalTotal" styleClass="modal-amount-value" text="₱0.00" />
            </HBox>
            <HBox spacing="12.0">
                <Button onAction="#closeConfirmationModal" prefWidth="130.0" styleClass="btn-secondary" text="Cancel" />
                <Button onAction="#confirmAndFinalizeOrder" prefWidth="160.0" styleClass="btn-primary" text="Confirm &amp; Print" />
            </HBox>
        </VBox>
    </StackPane>
</StackPane>