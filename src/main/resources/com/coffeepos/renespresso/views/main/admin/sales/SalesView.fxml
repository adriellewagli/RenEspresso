<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20.0" styleClass="sales-container"
      stylesheets="@../../../styles/admin/sales/sales.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.coffeepos.renespresso.controller.main.admin.sales.SalesController">

    <VBox spacing="4.0" styleClass="page-header">
        <Label styleClass="sales-title" text="Sales" />
        <Label styleClass="sales-subtitle" text="Track revenue and sales performance" />
    </VBox>

    <HBox spacing="16.0">
        <VBox styleClass="card, kpi-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label styleClass="kpi-title" text="TODAY'S SALES" />
            <Label styleClass="kpi-value" text="—" />
        </VBox>
        <VBox styleClass="card, kpi-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label styleClass="kpi-title" text="THIS WEEK" />
            <Label styleClass="kpi-value" text="—" />
        </VBox>
        <VBox styleClass="card, kpi-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label styleClass="kpi-title" text="THIS MONTH" />
            <Label styleClass="kpi-value" text="—" />
        </VBox>
    </HBox>

    <VBox alignment="CENTER" prefHeight="320.0" styleClass="card, panel-card" VBox.vgrow="ALWAYS">
        <Label styleClass="empty-note" text="Sales chart coming soon" />
    </VBox>
</VBox>