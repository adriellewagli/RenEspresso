<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="580.0" prefWidth="850.0" style="-fx-background-color: #5E3023;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.coffeepos.renespresso.controller.id.RegisterController">
    <children>
        <HBox alignment="CENTER" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>

                <!-- Left Branding Container with Clip to prevent stretching -->
                <StackPane maxWidth="350.0" minWidth="350.0" prefWidth="350.0">

                    <!-- This clip hides any excess width from the un-stretched image -->
                    <clip>
                        <Rectangle height="580.0" width="350.0" />
                    </clip>

                    <children>
                        <!-- Background Image: preserveRatio="true" stops the stretching -->
                        <ImageView fitHeight="580.0" preserveRatio="true">
                            <image>
                                <Image url="@../../images/BackgroundImage.jpg" />
                            </image>
                            <effect>
                                <GaussianBlur radius="6.0" />
                            </effect>
                        </ImageView>

                        <!-- Warm Dark Espresso Gradient Tint Overlay -->
                        <Region style="-fx-background-color: linear-gradient(to bottom, rgba(43, 20, 13, 0.65), rgba(66, 29, 18, 0.55));" />

                        <!-- Foreground Branding Content -->
                        <VBox alignment="CENTER" spacing="12.0">
                            <padding>
                                <Insets bottom="40.0" left="35.0" right="35.0" top="40.0" />
                            </padding>
                            <children>
                                <!-- Main Brand Title -->
                                <Label style="-fx-text-fill: #F3E9DC;" text="RenEspresso">
                                    <font>
                                        <Font name="System Bold" size="34.0" />
                                    </font>
                                    <effect>
                                        <DropShadow blurType="GAUSSIAN" color="#000000B3" height="12.0" radius="5.5" width="12.0" />
                                    </effect>
                                </Label>

                                <!-- Subtitle Badge Style -->
                                <Label style="-fx-text-fill: #F3E9DC; -fx-background-color: rgba(243, 233, 220, 0.18); -fx-background-radius: 12px; -fx-padding: 4 14 4 14; -fx-border-color: rgba(243, 233, 220, 0.3); -fx-border-radius: 12px;" text="COFFEE SHOP POS">
                                    <font>
                                        <Font name="System Bold" size="10.0" />
                                    </font>
                                </Label>

                                <!-- Decorative Divider Line -->
                                <Line endX="40.0" startX="-40.0" stroke="#F3E9DC" strokeWidth="1.2">
                                    <VBox.margin>
                                        <Insets top="6.0" />
                                    </VBox.margin>
                                    <effect>
                                        <DropShadow blurType="GAUSSIAN" color="#00000040" height="4.0" radius="1.5" width="4.0" />
                                    </effect>
                                </Line>

                                <!-- Slogan -->
                                <Label style="-fx-text-fill: #F3E9DC; -fx-opacity: 0.9;" text="Quick, secure, and brewed&#10;to perfection." textAlignment="CENTER">
                                    <font>
                                        <Font name="System Italic" size="14.0" />
                                    </font>
                                    <effect>
                                        <DropShadow blurType="GAUSSIAN" color="#00000066" height="6.0" radius="2.5" width="6.0" />
                                    </effect>
                                    <VBox.margin>
                                        <Insets top="2.0" />
                                    </VBox.margin>
                                </Label>
                            </children>
                        </VBox>
                    </children>
                </StackPane>

                <!-- Right Form Container (Register Screen) -->
                <VBox alignment="CENTER_LEFT" prefWidth="500.0" spacing="14.0" style="-fx-background-color: #F3E9DC;" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets bottom="24.0" left="50.0" right="50.0" top="24.0" />
                    </padding>
                    <children>

                        <!-- Form Header -->
                        <VBox spacing="4.0">
                            <children>
                                <Label style="-fx-text-fill: #5E3023;" text="Register Account">
                                    <font>
                                        <Font name="System Bold" size="24.0" />
                                    </font>
                                </Label>
                                <Label style="-fx-text-fill: #5E3023; -fx-opacity: 0.75;" text="Please fill in your details to create a new account.">
                                    <font>
                                        <Font size="12.0" />
                                    </font>
                                </Label>
                            </children>
                            <VBox.margin>
                                <Insets bottom="2.0" />
                            </VBox.margin>
                        </VBox>

                        <!-- Input Fields Container -->
                        <VBox spacing="10.0">
                            <children>

                                <!-- Username Field -->
                                <VBox spacing="3.0">
                                    <children>
                                        <Label style="-fx-text-fill: #5E3023;" text="USERNAME">
                                            <font>
                                                <Font name="System Bold" size="10.0" />
                                            </font>
                                        </Label>
                                        <TextField fx:id="usernameField" prefHeight="38.0" promptText="Choose a username" style="-fx-background-color: #F3E9DC; -fx-border-color: #5E3023; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 0 12; -fx-text-fill: #5E3023;" />
                                    </children>
                                </VBox>

                                <!-- Full Name Field -->
                                <VBox spacing="3.0">
                                    <children>
                                        <Label style="-fx-text-fill: #5E3023;" text="FULL NAME">
                                            <font>
                                                <Font name="System Bold" size="10.0" />
                                            </font>
                                        </Label>
                                        <TextField fx:id="fullNameField" prefHeight="38.0" promptText="Enter your full name" style="-fx-background-color: #F3E9DC; -fx-border-color: #5E3023; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 0 12; -fx-text-fill: #5E3023;" />
                                    </children>
                                </VBox>

                                <!-- Email Field -->
                                <VBox spacing="3.0">
                                    <children>
                                        <Label style="-fx-text-fill: #5E3023;" text="EMAIL ADDRESS">
                                            <font>
                                                <Font name="System Bold" size="10.0" />
                                            </font>
                                        </Label>
                                        <TextField fx:id="emailField" prefHeight="38.0" promptText="Enter your email" style="-fx-background-color: #F3E9DC; -fx-border-color: #5E3023; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 0 12; -fx-text-fill: #5E3023;" />
                                    </children>
                                </VBox>

                                <!-- Password Field with Embedded SVG Eye Icon -->
                                <VBox spacing="3.0">
                                    <children>
                                        <Label style="-fx-text-fill: #5E3023;" text="PASSWORD">
                                            <font>
                                                <Font name="System Bold" size="10.0" />
                                            </font>
                                        </Label>

                                        <StackPane alignment="CENTER_RIGHT">
                                            <children>
                                                <PasswordField fx:id="passwordField" prefHeight="38.0" promptText="Create a password" style="-fx-background-color: #F3E9DC; -fx-border-color: #5E3023; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 0 38 0 12; -fx-text-fill: #5E3023;" />
                                                <TextField fx:id="visiblePasswordField" managed="false" prefHeight="38.0" promptText="Create a password" style="-fx-background-color: #F3E9DC; -fx-border-color: #5E3023; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 0 38 0 12; -fx-text-fill: #5E3023;" visible="false" />

                                                <Button fx:id="togglePasswordButton" focusTraversable="false" onAction="#togglePasswordVisibility" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 0 10 0 0;">
                                                    <graphic>
                                                        <SVGPath fx:id="eyeIconPath1" content="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.44-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zM11.84 9.02l3.15 3.15.02-.17c0-1.66-1.34-3-3-3l-.17.02z" fill="#5E3023" opacity="0.55" />
                                                    </graphic>
                                                </Button>
                                            </children>
                                        </StackPane>
                                    </children>
                                </VBox>

                                <!-- Confirm Password Field -->
                                <VBox spacing="3.0">
                                    <children>
                                        <Label style="-fx-text-fill: #5E3023;" text="CONFIRM PASSWORD">
                                            <font>
                                                <Font name="System Bold" size="10.0" />
                                            </font>
                                        </Label>

                                        <StackPane alignment="CENTER_RIGHT">
                                            <children>
                                                <PasswordField fx:id="confirmPasswordField" prefHeight="38.0" promptText="Confirm your password" style="-fx-background-color: #F3E9DC; -fx-border-color: #5E3023; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 0 38 0 12; -fx-text-fill: #5E3023;" />
                                                <TextField fx:id="visibleConfirmPasswordField" managed="false" prefHeight="38.0" promptText="Confirm your password" style="-fx-background-color: #F3E9DC; -fx-border-color: #5E3023; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 0 38 0 12; -fx-text-fill: #5E3023;" visible="false" />

                                                <Button fx:id="toggleConfirmPasswordButton" focusTraversable="false" onAction="#toggleConfirmPasswordVisibility" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 0 10 0 0;">
                                                    <graphic>
                                                        <SVGPath fx:id="eyeIconPath2" content="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.44-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zM11.84 9.02l3.15 3.15.02-.17c0-1.66-1.34-3-3-3l-.17.02z" fill="#5E3023" opacity="0.55" />
                                                    </graphic>
                                                </Button>
                                            </children>
                                        </StackPane>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                        <!-- Action Buttons & Navigation -->
                        <VBox alignment="CENTER" spacing="10.0">
                            <children>
                                <Button fx:id="signUpButton" maxWidth="1.7976931348623157E308" onAction="#handleSignUp" prefHeight="40.0" style="-fx-background-color: #5E3023; -fx-background-radius: 8px; -fx-text-fill: #F3E9DC; -fx-cursor: hand;" text="REGISTER">
                                    <font>
                                        <Font name="System Bold" size="13.0" />
                                    </font>
                                </Button>

                                <HBox alignment="CENTER" spacing="4.0">
                                    <children>
                                        <Label style="-fx-text-fill: #5E3023; -fx-opacity: 0.8;" text="Already have an account?">
                                            <font>
                                                <Font size="12.0" />
                                            </font>
                                        </Label>
                                        <Hyperlink fx:id="loginLink" onAction="#handleLoginNavigation" style="-fx-text-fill: #5E3023; -fx-underline: TRUE;" text="Login">
                                            <font>
                                                <Font name="System Bold" size="12.0" />
                                            </font>
                                        </Hyperlink>
                                    </children>
                                </HBox>
                            </children>
                            <VBox.margin>
                                <Insets top="4.0" />
                            </VBox.margin>
                        </VBox>

                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</AnchorPane>