<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="580.0" prefWidth="850.0" style="-fx-background-color: #5E3023;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.coffeepos.renespresso.controller.id.LoginController">
    <children>
        <HBox alignment="CENTER" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>

                <!-- Left Branding Container (Brownie Dominant) -->
                <VBox alignment="CENTER" prefWidth="350.0" spacing="12.0" style="-fx-background-color: #5E3023;" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
                    </padding>
                    <children>
                        <!-- Logo Text Placeholder -->
                        <Label style="-fx-font-size: 42px;" text="☕" />

                        <Label style="-fx-text-fill: #F3E9DC;" text="Renespresso">
                            <font>
                                <Font name="System Bold" size="28.0" />
                            </font>
                        </Label>

                        <Label style="-fx-text-fill: #F3E9DC;" text="COFFEE SHOP POS">
                            <font>
                                <Font size="11.0" />
                            </font>
                        </Label>

                        <Label style="-fx-text-fill: #F3E9DC; -fx-opacity: 0.85;" text="Quick, secure, and brewed&#10;to perfection." textAlignment="CENTER">
                            <font>
                                <Font name="System Italic" size="13.0" />
                            </font>
                            <VBox.margin>
                                <Insets top="10.0" />
                            </VBox.margin>
                        </Label>
                    </children>
                </VBox>

                <!-- Right Form Container (Cream White Replacement) -->
                <VBox alignment="CENTER_LEFT" prefWidth="500.0" spacing="20.0" style="-fx-background-color: #F3E9DC;" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets bottom="40.0" left="50.0" right="50.0" top="40.0" />
                    </padding>
                    <children>

                        <!-- Form Header -->
                        <VBox spacing="4.0">
                            <children>
                                <Label style="-fx-text-fill: #5E3023;" text="Login Account">
                                    <font>
                                        <Font name="System Bold" size="26.0" />
                                    </font>
                                </Label>
                                <Label style="-fx-text-fill: #5E3023; -fx-opacity: 0.75;" text="Please enter your details to login.">
                                    <font>
                                        <Font size="13.0" />
                                    </font>
                                </Label>
                            </children>
                            <VBox.margin>
                                <Insets bottom="6.0" />
                            </VBox.margin>
                        </VBox>

                        <!-- Input Fields -->
                        <VBox spacing="14.0">
                            <children>
                                <!-- Username Field -->
                                <VBox spacing="4.0">
                                    <children>
                                        <Label style="-fx-text-fill: #5E3023;" text="USERNAME">
                                            <font>
                                                <Font name="System Bold" size="10.0" />
                                            </font>
                                        </Label>
                                        <TextField fx:id="usernameField" prefHeight="42.0" promptText="Enter your username" style="-fx-background-color: #F3E9DC; -fx-border-color: #5E3023; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 0 12; -fx-text-fill: #5E3023;" />
                                    </children>
                                </VBox>

                                <!-- Password Field with Embedded SVG Eye Icon -->
                                <VBox spacing="4.0">
                                    <children>
                                        <Label style="-fx-text-fill: #5E3023;" text="PASSWORD">
                                            <font>
                                                <Font name="System Bold" size="10.0" />
                                            </font>
                                        </Label>

                                        <StackPane alignment="CENTER_RIGHT">
                                            <children>
                                                <PasswordField fx:id="passwordField" prefHeight="42.0" promptText="Enter your password" style="-fx-background-color: #F3E9DC; -fx-border-color: #5E3023; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 0 38 0 12; -fx-text-fill: #5E3023;" />
                                                <TextField fx:id="visiblePasswordField" managed="false" prefHeight="42.0" promptText="Enter your password" style="-fx-background-color: #F3E9DC; -fx-border-color: #5E3023; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 0 38 0 12; -fx-text-fill: #5E3023;" visible="false" />

                                                <Button fx:id="togglePasswordButton" focusTraversable="false" onAction="#togglePasswordVisibility" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 0 10 0 0;">
                                                    <graphic>
                                                        <SVGPath fx:id="eyeIconPath" content="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.44-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zM11.84 9.02l3.15 3.15.02-.17c0-1.66-1.34-3-3-3l-.17.02z" fill="#5E3023" opacity="0.55" />
                                                    </graphic>
                                                </Button>
                                            </children>
                                        </StackPane>
                                    </children>
                                </VBox>

                                <!-- Forgot Password Link -->
                                <HBox alignment="CENTER_RIGHT">
                                    <children>
                                        <Hyperlink fx:id="forgotPasswordLink" onAction="#handleForgotPasswordNavigation" style="-fx-text-fill: #5E3023; -fx-underline: false; -fx-opacity: 0.85;" text="Forgot Password?">
                                            <font>
                                                <Font size="11.0" />
                                            </font>
                                        </Hyperlink>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- Action Buttons & Navigation -->
                        <VBox alignment="CENTER" spacing="12.0">
                            <children>
                                <Button fx:id="loginButton" maxWidth="1.7976931348623157E308" onAction="#handleLogin" prefHeight="44.0" style="-fx-background-color: #5E3023; -fx-background-radius: 8px; -fx-text-fill: #F3E9DC; -fx-cursor: hand;" text="LOGIN">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Button>

                                <!-- OR Divider with Lines -->
                                <HBox alignment="CENTER" spacing="10.0">
                                    <children>
                                        <Separator style="-fx-background-color: #5E3023; -fx-opacity: 0.3;" HBox.hgrow="ALWAYS" />
                                        <Label style="-fx-text-fill: #5E3023; -fx-opacity: 0.6;" text="OR">
                                            <font>
                                                <Font name="System Bold" size="11.0" />
                                            </font>
                                        </Label>
                                        <Separator style="-fx-background-color: #5E3023; -fx-opacity: 0.3;" HBox.hgrow="ALWAYS" />
                                    </children>
                                    <VBox.margin>
                                        <Insets bottom="2.0" top="2.0" />
                                    </VBox.margin>
                                </HBox>

                                <HBox alignment="CENTER" spacing="4.0">
                                    <children>
                                        <Label style="-fx-text-fill: #5E3023; -fx-opacity: 0.8;" text="Don't have an account?">
                                            <font>
                                                <Font size="12.0" />
                                            </font>
                                        </Label>
                                        <Hyperlink fx:id="registerLink" onAction="#handleRegisterNavigation" style="-fx-text-fill: #5E3023; -fx-underline: TRUE;" text="Register">
                                            <font>
                                                <Font name="System Bold" size="12.0" />
                                            </font>
                                        </Hyperlink>
                                    </children>
                                </HBox>
                            </children>
                            <VBox.margin>
                                <Insets top="6.0" />
                            </VBox.margin>
                        </VBox>

                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</AnchorPane>
