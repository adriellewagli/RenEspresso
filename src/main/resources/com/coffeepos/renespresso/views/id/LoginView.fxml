<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="580.0" prefWidth="850.0" style="-fx-background-color: #F3E9DC;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.coffeepos.renespresso.controller.id.LoginController">
    <children>

        <!-- ============ BACK WAVE (coffee) ============ -->
        <Pane mouseTransparent="true" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <SVGPath content="M0 0 L438 0 C366 105 456 200 418 300 C380 400 456 490 404 580 L0 580 Z" fill="#895737" />
            </children>
        </Pane>

        <!-- ============ LEFT : PHOTO CLIPPED TO THE WAVE ============ -->
        <Pane mouseTransparent="true" prefHeight="580.0" prefWidth="440.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">
            <clip>
                <SVGPath content="M0 0 L404 0 C332 105 422 200 384 300 C346 400 422 490 370 580 L0 580 Z" />
            </clip>
            <children>
                <ImageView fitHeight="580.0" fitWidth="440.0" preserveRatio="false">
                    <image>
                        <Image url="@../../images/BackgroundImage.jpg" />
                    </image>
                    <viewport>
                        <Rectangle2D height="672.0" minX="600.0" minY="0.0" width="500.0" />
                    </viewport>
                </ImageView>
                <!-- espresso tint so the text stays readable -->
                <Region prefHeight="580.0" prefWidth="440.0" style="-fx-background-color: linear-gradient(to bottom, rgba(40, 20, 12, 0.62), rgba(94, 48, 35, 0.72));" />
            </children>
        </Pane>

        <!-- ============ LEFT : BRANDING (centered in the visible photo area) ============ -->
        <VBox alignment="CENTER" prefWidth="394.0" spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>

                <HBox alignment="CENTER" spacing="0.0">
                    <children>
                        <Label style="-fx-text-fill: #F3E9DC;" text="Ren">
                            <font>
                                <Font name="Georgia Bold Italic" size="44.0" />
                            </font>
                            <effect>
                                <DropShadow blurType="GAUSSIAN" color="#000000AA" height="10.0" offsetY="2.0" radius="4.5" width="10.0" />
                            </effect>
                        </Label>
                        <Label style="-fx-text-fill: #C08552;" text="Espresso">
                            <font>
                                <Font name="Georgia Bold Italic" size="44.0" />
                            </font>
                            <effect>
                                <DropShadow blurType="GAUSSIAN" color="#000000AA" height="10.0" offsetY="2.0" radius="4.5" width="10.0" />
                            </effect>
                        </Label>
                    </children>
                </HBox>

                <Label alignment="CENTER" style="-fx-text-fill: #F3E9DC;" text="C O F F E E   S H O P" textAlignment="CENTER">
                    <font>
                        <Font name="System Bold" size="13.0" />
                    </font>
                </Label>

                <Region maxHeight="2.0" maxWidth="44.0" minHeight="2.0" minWidth="44.0" style="-fx-background-color: #C08552; -fx-background-radius: 2px;">
                    <VBox.margin>
                        <Insets bottom="2.0" top="4.0" />
                    </VBox.margin>
                </Region>

                <Label alignment="CENTER" style="-fx-text-fill: #E9D8C4;" text="Quick, secure, and brewed&#10;to perfection." textAlignment="CENTER">
                    <font>
                        <Font name="Georgia Italic" size="14.0" />
                    </font>
                </Label>
            </children>
        </VBox>

        <!-- ============ RIGHT : FORM (centered in the dark area) ============ -->
        <VBox alignment="CENTER" spacing="16.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="485.0" AnchorPane.rightAnchor="55.0" AnchorPane.topAnchor="0.0">
            <children>

                <!-- Logo badge -->
                <StackPane>
                    <children>
                        <Circle fill="#5E3023" radius="28.0" stroke="#C08552" strokeWidth="2.5">
                            <effect>
                                <DropShadow blurType="GAUSSIAN" color="#5E303566" height="22.0" radius="10.5" width="22.0" />
                            </effect>
                        </Circle>
                        <SVGPath content="M20 3H4v10c0 2.21 1.79 4 4 4h6c2.21 0 4-1.79 4-4v-3h2c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 5h-2V5h2v3zM2 21h18v-2H2v2z" fill="#F3E9DC" scaleX="1.05" scaleY="1.05" />
                    </children>
                </StackPane>

                <!-- Heading -->
                <VBox alignment="CENTER" spacing="4.0">
                    <children>
                        <Label style="-fx-text-fill: #5E3023;" text="Welcome Back">
                            <font>
                                <Font name="Georgia Bold" size="28.0" />
                            </font>
                        </Label>
                        <Label style="-fx-text-fill: #895737;" text="Please login to your account to proceed.">
                            <font>
                                <Font size="12.0" />
                            </font>
                        </Label>
                    </children>
                    <VBox.margin>
                        <Insets bottom="8.0" />
                    </VBox.margin>
                </VBox>

                <!-- Username -->
                <VBox spacing="6.0">
                    <children>
                        <Label style="-fx-text-fill: #895737;" text="USERNAME">
                            <font>
                                <Font name="System Bold" size="10.0" />
                            </font>
                        </Label>
                        <StackPane alignment="CENTER_LEFT">
                            <children>
                                <TextField fx:id="usernameField" prefHeight="46.0" promptText="Enter your username" style="-fx-background-color: #FFFFFF; -fx-background-radius: 10px; -fx-border-color: #D9C3AE; -fx-border-radius: 10px; -fx-padding: 0 14 0 42; -fx-text-fill: #5E3023; -fx-prompt-text-fill: #8F735F; -fx-font-size: 13px; -fx-focus-color: #C08552; -fx-faint-focus-color: transparent;" />
                                <SVGPath content="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" fill="#895737" mouseTransparent="true" scaleX="0.8" scaleY="0.8">
                                    <StackPane.margin>
                                        <Insets left="12.0" />
                                    </StackPane.margin>
                                </SVGPath>
                            </children>
                        </StackPane>
                    </children>
                </VBox>

                <!-- Password -->
                <VBox spacing="6.0">
                    <children>
                        <Label style="-fx-text-fill: #895737;" text="PASSWORD">
                            <font>
                                <Font name="System Bold" size="10.0" />
                            </font>
                        </Label>
                        <StackPane alignment="CENTER_RIGHT">
                            <children>
                                <PasswordField fx:id="passwordField" prefHeight="46.0" promptText="Enter your password" style="-fx-background-color: #FFFFFF; -fx-background-radius: 10px; -fx-border-color: #D9C3AE; -fx-border-radius: 10px; -fx-padding: 0 46 0 42; -fx-text-fill: #5E3023; -fx-prompt-text-fill: #8F735F; -fx-font-size: 13px; -fx-focus-color: #C08552; -fx-faint-focus-color: transparent;" />
                                <TextField fx:id="visiblePasswordField" managed="false" prefHeight="46.0" promptText="Enter your password" style="-fx-background-color: #FFFFFF; -fx-background-radius: 10px; -fx-border-color: #D9C3AE; -fx-border-radius: 10px; -fx-padding: 0 46 0 42; -fx-text-fill: #5E3023; -fx-prompt-text-fill: #8F735F; -fx-font-size: 13px; -fx-focus-color: #C08552; -fx-faint-focus-color: transparent;" visible="false" />

                                <!-- Lock -->
                                <SVGPath content="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z" fill="#895737" mouseTransparent="true" scaleX="0.7" scaleY="0.7" StackPane.alignment="CENTER_LEFT">
                                    <StackPane.margin>
                                        <Insets left="12.0" />
                                    </StackPane.margin>
                                </SVGPath>

                                <!-- Eye toggle -->
                                <Button fx:id="togglePasswordButton" focusTraversable="false" onAction="#togglePasswordVisibility" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 0 10 0 0;">
                                    <graphic>
                                        <SVGPath fx:id="eyeIconPath" content="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.44-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zM11.84 9.02l3.15 3.15.02-.17c0-1.66-1.34-3-3-3l-.17.02z" fill="#895737" opacity="0.85" scaleX="0.75" scaleY="0.75" />
                                    </graphic>
                                </Button>
                            </children>
                        </StackPane>
                    </children>
                </VBox>

                <!-- Divider between the fields and the button (single clean line, no text) -->
                <Region maxHeight="1.0" minHeight="1.0" prefHeight="1.0" style="-fx-background-color: rgba(94,48,35,0.20);">
                    <VBox.margin>
                        <Insets bottom="2.0" top="8.0" />
                    </VBox.margin>
                </Region>

                <!-- Sign in -->
                <Button fx:id="loginButton" onAction="#handleLogin" prefHeight="46.0" prefWidth="210.0" style="-fx-background-color: linear-gradient(to bottom, #6E3A2A, #5E3023); -fx-background-radius: 23px; -fx-text-fill: #F3E9DC; -fx-cursor: hand;" text="Sign in">
                    <font>
                        <Font name="Georgia Bold" size="15.0" />
                    </font>
                    <effect>
                        <DropShadow blurType="GAUSSIAN" color="#5E303599" height="16.0" offsetY="4.0" radius="7.5" width="16.0" />
                    </effect>
                </Button>

                <!-- Server Connection status button -->
                <Button fx:id="btnServerConfig" focusTraversable="false" onAction="#handleOpenServerConfig"
                        style="-fx-background-color: transparent; -fx-cursor: hand; -fx-text-fill: #895737; -fx-font-size: 11px; -fx-padding: 4 8;"
                        text="🖥️ Server: localhost">
                    <VBox.margin>
                        <Insets top="2.0" />
                    </VBox.margin>
                </Button>

            </children>
        </VBox>
    </children>
</AnchorPane>
