<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="580.0" prefWidth="850.0" style="-fx-background-color: #2D1810;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.coffeepos.renespresso.controller.id.LoginController">
    <children>
        <HBox alignment="CENTER" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>

                <!-- Left Branding Container with Clip -->
                <StackPane maxWidth="360.0" minWidth="360.0" prefWidth="360.0">
                    <clip>
                        <Rectangle height="580.0" width="360.0" />
                    </clip>

                    <children>
                        <!-- Background Image -->
                        <ImageView fitHeight="580.0" preserveRatio="true">
                            <image>
                                <Image url="@../../images/BackgroundImage.jpg" />
                            </image>
                            <effect>
                                <GaussianBlur radius="4.0" />
                            </effect>
                        </ImageView>

                        <!-- Warm Dark Espresso Tint Overlay -->
                        <Region style="-fx-background-color: linear-gradient(to bottom, rgba(25, 12, 7, 0.70), rgba(45, 24, 16, 0.60));" />

                        <!-- Glassmorphism Container -->
                        <VBox alignment="CENTER" spacing="0.0">
                            <padding>
                                <Insets bottom="40.0" left="30.0" right="30.0" top="40.0" />
                            </padding>
                            <children>
                                <VBox alignment="CENTER" spacing="12.0" style="-fx-background-color: rgba(25, 12, 7, 0.65); -fx-background-radius: 20px; -fx-padding: 32 24; -fx-border-color: rgba(243, 233, 220, 0.25); -fx-border-radius: 20px; -fx-border-width: 1.5px;">
                                    <effect>
                                        <DropShadow blurType="GAUSSIAN" color="#00000080" height="20.0" radius="9.5" width="20.0" />
                                    </effect>
                                    <children>
                                        <!-- SVG Coffee Cup Icon -->
                                        <SVGPath content="M20 3H4v10c0 2.21 1.79 4 4 4h6c2.21 0 4-1.79 4-4v-3h2c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 5h-2V5h2v3zM2 21h18v-2H2v2z" fill="#C08552" scaleX="1.3" scaleY="1.3">
                                            <VBox.margin>
                                                <Insets bottom="2.0" top="2.0" />
                                            </VBox.margin>
                                        </SVGPath>

                                        <!-- Main Brand Title -->
                                        <Label style="-fx-text-fill: #FFFFFF;" text="RenEspresso">
                                            <font>
                                                <Font name="System Bold" size="32.0" />
                                            </font>
                                            <effect>
                                                <DropShadow blurType="GAUSSIAN" color="#00000099" height="8.0" radius="3.5" width="8.0" />
                                            </effect>
                                        </Label>

                                        <!-- Amber Pill Badge -->
                                        <Label style="-fx-text-fill: #FFFFFF; -fx-background-color: #C08552; -fx-background-radius: 12px; -fx-padding: 4 14 4 14;" text="COFFEE SHOP POS">
                                            <font>
                                                <Font name="System Bold" size="10.0" />
                                            </font>
                                        </Label>

                                        <!-- Divider Line -->
                                        <Line endX="35.0" startX="-35.0" stroke="#F3E9DC" strokeWidth="1.0" opacity="0.25">
                                            <VBox.margin>
                                                <Insets bottom="2.0" top="4.0" />
                                            </VBox.margin>
                                        </Line>

                                        <!-- Slogan -->
                                        <Label style="-fx-text-fill: #D4C5B9;" text="Quick, secure, and brewed&#10;to perfection." textAlignment="CENTER">
                                            <font>
                                                <Font name="System Italic" size="13.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </StackPane>

                <!-- Right Form Outer Background Panel -->
                <VBox alignment="CENTER" prefWidth="490.0" style="-fx-background-color: #F8F5F0;" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets bottom="30.0" left="35.0" right="35.0" top="30.0" />
                    </padding>
                    <children>

                        <!-- Elevated White Card Wrapper -->
                        <VBox alignment="CENTER_LEFT" spacing="18.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 16px; -fx-padding: 30; -fx-border-color: #E3D9CD; -fx-border-radius: 16px; -fx-border-width: 1px;">
                            <effect>
                                <DropShadow blurType="GAUSSIAN" color="#0000000D" height="15.0" radius="7.0" width="15.0" />
                            </effect>
                            <children>

                                <!-- Form Header (Without Active Badge) -->
                                <VBox spacing="4.0">
                                    <children>
                                        <Label style="-fx-text-fill: #2D1810;" text="Login Account">
                                            <font>
                                                <Font name="System Bold" size="26.0" />
                                            </font>
                                        </Label>
                                        <Label style="-fx-text-fill: #7D6B5D;" text="Please enter your cashier details to continue.">
                                            <font>
                                                <Font size="12.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>

                                <!-- Input Fields with Left Vector Icons -->
                                <VBox spacing="14.0">
                                    <children>
                                        <!-- Username Field with Left User Icon -->
                                        <VBox spacing="4.0">
                                            <children>
                                                <Label style="-fx-text-fill: #2D1810;" text="USERNAME">
                                                    <font>
                                                        <Font name="System Bold" size="10.0" />
                                                    </font>
                                                </Label>
                                                <StackPane alignment="CENTER_LEFT">
                                                    <children>
                                                        <TextField fx:id="usernameField" prefHeight="42.0" promptText="Enter your username" style="-fx-background-color: #FAFAFA; -fx-border-color: #C08552; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 0 14 0 38; -fx-text-fill: #2D1810; -fx-font-size: 13px;" />
                                                        <SVGPath content="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" fill="#A08C80" scaleX="0.9" scaleY="0.9">
                                                            <StackPane.margin>
                                                                <Insets left="12.0" />
                                                            </StackPane.margin>
                                                        </SVGPath>
                                                    </children>
                                                </StackPane>
                                            </children>
                                        </VBox>

                                        <!-- Password Field with Left Lock Icon & Right Eye Toggle -->
                                        <VBox spacing="4.0">
                                            <children>
                                                <Label style="-fx-text-fill: #2D1810;" text="PASSWORD">
                                                    <font>
                                                        <Font name="System Bold" size="10.0" />
                                                    </font>
                                                </Label>

                                                <StackPane alignment="CENTER_RIGHT">
                                                    <children>
                                                        <PasswordField fx:id="passwordField" prefHeight="42.0" promptText="Enter your password" style="-fx-background-color: #FAFAFA; -fx-border-color: #C08552; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 0 40 0 38; -fx-text-fill: #2D1810; -fx-font-size: 13px;" />
                                                        <TextField fx:id="visiblePasswordField" managed="false" prefHeight="42.0" promptText="Enter your password" style="-fx-background-color: #FAFAFA; -fx-border-color: #C08552; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 0 40 0 38; -fx-text-fill: #2D1810; -fx-font-size: 13px;" visible="false" />

                                                        <!-- Embedded Lock Icon on Left -->
                                                        <SVGPath content="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z" fill="#A08C80" scaleX="0.8" scaleY="0.8" StackPane.alignment="CENTER_LEFT">
                                                            <StackPane.margin>
                                                                <Insets left="12.0" />
                                                            </StackPane.margin>
                                                        </SVGPath>

                                                        <!-- Toggle Password Visibility Eye Icon on Right -->
                                                        <Button fx:id="togglePasswordButton" focusTraversable="false" onAction="#togglePasswordVisibility" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 0 12 0 0;">
                                                            <graphic>
                                                                <SVGPath fx:id="eyeIconPath" content="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.44-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zM11.84 9.02l3.15 3.15.02-.17c0-1.66-1.34-3-3-3l-.17.02z" fill="#7D6B5D" opacity="0.65" />
                                                            </graphic>
                                                        </Button>
                                                    </children>
                                                </StackPane>
                                            </children>
                                        </VBox>

                                        <!-- Forgot Password Link -->
                                        <HBox alignment="CENTER_RIGHT">
                                            <children>
                                                <Hyperlink fx:id="forgotPasswordLink" onAction="#handleForgotPasswordNavigation" style="-fx-text-fill: #C08552; -fx-underline: false;" text="Forgot Password?">
                                                    <font>
                                                        <Font name="System Bold" size="11.0" />
                                                    </font>
                                                </Hyperlink>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <!-- Action Button with Ambient Amber Glow -->
                                <VBox alignment="CENTER" spacing="12.0">
                                    <children>
                                        <Button fx:id="loginButton" maxWidth="1.7976931348623157E308" onAction="#handleLogin" prefHeight="44.0" style="-fx-background-color: linear-gradient(to right, #2D1810, #4A2E20); -fx-background-radius: 8px; -fx-text-fill: #FFFFFF; -fx-cursor: hand;" text="LOGIN">
                                            <font>
                                                <Font name="System Bold" size="14.0" />
                                            </font>
                                            <effect>
                                                <DropShadow blurType="GAUSSIAN" color="#C0855266" height="18.0" radius="8.5" width="18.0" />
                                            </effect>
                                        </Button>

                                        <!-- OR Divider -->
                                        <HBox alignment="CENTER" spacing="10.0">
                                            <children>
                                                <Separator style="-fx-background-color: transparent; -fx-border-color: #E3D9CD; -fx-border-width: 1px 0 0 0;" HBox.hgrow="ALWAYS" />
                                                <Label style="-fx-text-fill: #A08C80;" text="OR">
                                                    <font>
                                                        <Font name="System Bold" size="11.0" />
                                                    </font>
                                                </Label>
                                                <Separator style="-fx-background-color: transparent; -fx-border-color: #E3D9CD; -fx-border-width: 1px 0 0 0;" HBox.hgrow="ALWAYS" />
                                            </children>
                                        </HBox>

                                        <!-- Register Footer -->
                                        <HBox alignment="CENTER" spacing="4.0">
                                            <children>
                                                <Label style="-fx-text-fill: #7D6B5D;" text="Don't have an account?">
                                                    <font>
                                                        <Font size="12.0" />
                                                    </font>
                                                </Label>
                                                <Hyperlink fx:id="registerLink" onAction="#handleRegisterNavigation" style="-fx-text-fill: #C08552; -fx-underline: true;" text="Register">
                                                    <font>
                                                        <Font name="System Bold" size="12.0" />
                                                    </font>
                                                </Hyperlink>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                            </children>
                        </VBox>

                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</AnchorPane>