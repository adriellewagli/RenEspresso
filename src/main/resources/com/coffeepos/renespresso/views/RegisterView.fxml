<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="580.0" prefWidth="850.0" style="-fx-background-color: #f5e6ca;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.coffeepos.renespresso.controller.RegisterController">
    <children>
        <HBox alignment="CENTER" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>

                <!-- Left Branding Container -->
                <VBox alignment="CENTER" prefWidth="350.0" spacing="12.0" style="-fx-background-color: #dcc7aa;" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
                    </padding>
                    <children>
                        <!-- Logo Text Placeholder -->
                        <Label style="-fx-font-size: 42px;" text="☕" />

                        <Label style="-fx-text-fill: #6f4e37;" text="Renespresso">
                            <font>
                                <Font name="System Bold" size="28.0" />
                            </font>
                        </Label>

                        <Label style="-fx-text-fill: #6f4e37;" text="COFFEE SHOP POS">
                            <font>
                                <Font size="11.0" />
                            </font>
                        </Label>

                        <Label style="-fx-text-fill: #6f4e37; -fx-opacity: 0.85;" text="Quick, secure, and brewed&#10;to perfection." textAlignment="CENTER">
                            <font>
                                <Font name="System Italic" size="13.0" />
                            </font>
                            <VBox.margin>
                                <Insets top="10.0" />
                            </VBox.margin>
                        </Label>
                    </children>
                </VBox>

                <!-- Right Form Container -->
                <VBox alignment="CENTER_LEFT" prefWidth="500.0" spacing="16.0" style="-fx-background-color: #fffdf7;" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets bottom="35.0" left="50.0" right="50.0" top="35.0" />
                    </padding>
                    <children>

                        <!-- Form Header -->
                        <VBox spacing="4.0">
                            <children>
                                <Label style="-fx-text-fill: #6f4e37;" text="Create Account">
                                    <font>
                                        <Font name="System Bold" size="26.0" />
                                    </font>
                                </Label>
                                <Label style="-fx-text-fill: #6f4e37; -fx-opacity: 0.75;" text="Please enter your details to sign up.">
                                    <font>
                                        <Font size="13.0" />
                                    </font>
                                </Label>
                            </children>
                            <VBox.margin>
                                <Insets bottom="4.0" />
                            </VBox.margin>
                        </VBox>

                        <!-- Input Fields -->
                        <VBox spacing="12.0">
                            <children>
                                <!-- Full Name Field -->
                                <VBox spacing="4.0">
                                    <children>
                                        <Label style="-fx-text-fill: #6f4e37;" text="FULL NAME">
                                            <font>
                                                <Font name="System Bold" size="10.0" />
                                            </font>
                                        </Label>
                                        <TextField fx:id="fullNameField" prefHeight="40.0" promptText="Enter your full name" style="-fx-background-color: #fffdf7; -fx-border-color: #dcc7aa; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 0 12; -fx-text-fill: #6f4e37;" />
                                    </children>
                                </VBox>

                                <!-- Username Field -->
                                <VBox spacing="4.0">
                                    <children>
                                        <Label style="-fx-text-fill: #6f4e37;" text="USERNAME">
                                            <font>
                                                <Font name="System Bold" size="10.0" />
                                            </font>
                                        </Label>
                                        <TextField fx:id="usernameField" prefHeight="40.0" promptText="Enter your username" style="-fx-background-color: #fffdf7; -fx-border-color: #dcc7aa; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 0 12; -fx-text-fill: #6f4e37;" />
                                    </children>
                                </VBox>

                                <!-- Role Dropdown Field -->
                                <VBox spacing="4.0">
                                    <children>
                                        <Label style="-fx-text-fill: #6f4e37;" text="ACCOUNT ROLE">
                                            <font>
                                                <Font name="System Bold" size="10.0" />
                                            </font>
                                        </Label>
                                        <ComboBox fx:id="roleComboBox" maxWidth="1.7976931348623157E308" prefHeight="40.0" style="-fx-background-color: #fffdf7; -fx-border-color: #dcc7aa; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 0 4; -fx-text-fill: #6f4e37;" />
                                    </children>
                                </VBox>

                                <!-- Password Field -->
                                <VBox spacing="4.0">
                                    <children>
                                        <Label style="-fx-text-fill: #6f4e37;" text="PASSWORD">
                                            <font>
                                                <Font name="System Bold" size="10.0" />
                                            </font>
                                        </Label>

                                        <StackPane alignment="CENTER_RIGHT">
                                            <children>
                                                <PasswordField fx:id="passwordField" prefHeight="40.0" promptText="Enter your password" style="-fx-background-color: #fffdf7; -fx-border-color: #dcc7aa; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 0 38 0 12; -fx-text-fill: #6f4e37;" />
                                                <TextField fx:id="visiblePasswordField" managed="false" prefHeight="40.0" promptText="Enter your password" style="-fx-background-color: #fffdf7; -fx-border-color: #dcc7aa; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 0 38 0 12; -fx-text-fill: #6f4e37;" visible="false" />

                                                <Button focusTraversable="false" onAction="#togglePasswordVisibility" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 0 10 0 0;">
                                                    <graphic>
                                                        <SVGPath fx:id="eyeIconPath" content="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.44-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zM11.84 9.02l3.15 3.15.02-.17c0-1.66-1.34-3-3-3l-.17.02z" fill="#6f4e37" opacity="0.55" />
                                                    </graphic>
                                                </Button>
                                            </children>
                                        </StackPane>
                                    </children>
                                </VBox>

                                <!-- Confirm Password Field -->
                                <VBox spacing="4.0">
                                    <children>
                                        <Label style="-fx-text-fill: #6f4e37;" text="CONFIRM PASSWORD">
                                            <font>
                                                <Font name="System Bold" size="10.0" />
                                            </font>
                                        </Label>

                                        <StackPane alignment="CENTER_RIGHT">
                                            <children>
                                                <PasswordField fx:id="confirmPasswordField" prefHeight="40.0" promptText="Re-enter your password" style="-fx-background-color: #fffdf7; -fx-border-color: #dcc7aa; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 0 38 0 12; -fx-text-fill: #6f4e37;" />
                                                <TextField fx:id="visibleConfirmPasswordField" managed="false" prefHeight="40.0" promptText="Re-enter your password" style="-fx-background-color: #fffdf7; -fx-border-color: #dcc7aa; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 0 38 0 12; -fx-text-fill: #6f4e37;" visible="false" />

                                                <Button focusTraversable="false" onAction="#toggleConfirmPasswordVisibility" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 0 10 0 0;">
                                                    <graphic>
                                                        <SVGPath fx:id="confirmEyeIconPath" content="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.44-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zM11.84 9.02l3.15 3.15.02-.17c0-1.66-1.34-3-3-3l-.17.02z" fill="#6f4e37" opacity="0.55" />
                                                    </graphic>
                                                </Button>
                                            </children>
                                        </StackPane>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                        <!-- Action Buttons & Navigation -->
                        <VBox alignment="CENTER" spacing="10.0">
                            <children>
                                <Button fx:id="signUpButton" maxWidth="1.7976931348623157E308" prefHeight="42.0" style="-fx-background-color: #6f4e37; -fx-background-radius: 8px; -fx-text-fill: #fffdf7; -fx-cursor: hand;" text="Sign Up">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Button>

                                <HBox alignment="CENTER" spacing="4.0">
                                    <children>
                                        <Label style="-fx-text-fill: #6f4e37; -fx-opacity: 0.8;" text="Already have an account?">
                                            <font>
                                                <Font size="12.0" />
                                            </font>
                                        </Label>
                                        <Hyperlink fx:id="loginLink" style="-fx-text-fill: #6f4e37; -fx-underline: false;" text="Log In">
                                            <font>
                                                <Font name="System Bold" size="12.0" />
                                            </font>
                                        </Hyperlink>
                                    </children>
                                </HBox>
                            </children>
                            <VBox.margin>
                                <Insets top="6.0" />
                            </VBox.margin>
                        </VBox>

                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</AnchorPane>