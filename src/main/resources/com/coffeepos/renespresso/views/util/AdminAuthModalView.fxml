<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="430.0" spacing="16.0"
      style="-fx-background-color: #fffdf7; -fx-border-color: #dcc7aa; -fx-border-width: 1.5px; -fx-border-radius: 14px; -fx-background-radius: 14px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.18), 16, 0, 0, 4);"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.coffeepos.renespresso.controller.util.AdminAuthController">
    <padding>
        <Insets bottom="22.0" left="26.0" right="26.0" top="24.0" />
    </padding>
    <children>
        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <children>
                <Label fx:id="iconLabel" style="-fx-font-size: 26px; -fx-text-fill: #6f4e37;" text="🛡️" />
                <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="titleLabel" style="-fx-text-fill: #6f4e37;" text="Admin Authorization">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Label>
                        <Label fx:id="messageLabel" style="-fx-text-fill: #6B5444; -fx-font-size: 13px;" text="Admin credentials required to cancel this order." wrapText="true" />
                    </children>
                </VBox>
            </children>
        </HBox>

        <!-- Form fields -->
        <VBox spacing="12.0">
            <children>
                <VBox spacing="6.0">
                    <children>
                        <Label fx:id="lblUsernameHeader" style="-fx-text-fill: #5E3023; -fx-font-size: 12px; -fx-font-weight: bold;" text="USERNAME" />
                        <TextField fx:id="txtUsername" prefHeight="38.0" promptText="Enter username"
                                   style="-fx-background-color: #F8F2E8; -fx-background-radius: 8px; -fx-border-color: #E7DCCB; -fx-border-radius: 8px; -fx-padding: 0 12; -fx-text-fill: #2F2118; -fx-font-size: 13px;" />
                    </children>
                </VBox>
                <VBox spacing="6.0">
                    <children>
                        <Label fx:id="lblPasswordHeader" style="-fx-text-fill: #5E3023; -fx-font-size: 12px; -fx-font-weight: bold;" text="PASSWORD" />
                        <PasswordField fx:id="txtPassword" prefHeight="38.0" promptText="Enter password"
                                       style="-fx-background-color: #F8F2E8; -fx-background-radius: 8px; -fx-border-color: #E7DCCB; -fx-border-radius: 8px; -fx-padding: 0 12; -fx-text-fill: #2F2118; -fx-font-size: 13px;" />
                    </children>
                </VBox>
                <Label fx:id="lblError" managed="false" style="-fx-text-fill: #C53030; -fx-font-size: 12px; -fx-font-weight: bold;" text="" visible="false" wrapText="true" />
            </children>
        </VBox>

        <!-- Action Buttons -->
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button fx:id="btnCancel" cancelButton="true" onAction="#handleCancel" prefHeight="36.0" prefWidth="95.0"
                        style="-fx-background-color: transparent; -fx-border-color: #dcc7aa; -fx-border-radius: 8px; -fx-text-fill: #6f4e37; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 12px;" text="Cancel" />
                <Button fx:id="btnAuthorize" defaultButton="true" onAction="#handleAuthorize" prefHeight="36.0" prefWidth="165.0"
                        style="-fx-background-color: #6f4e37; -fx-text-fill: #fffdf7; -fx-background-radius: 8px; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 12px;" text="Authorize Cancel" />
            </children>
            <VBox.margin>
                <Insets top="4.0" />
            </VBox.margin>
        </HBox>
    </children>
</VBox>
