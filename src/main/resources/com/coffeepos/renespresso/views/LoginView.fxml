<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="850.0" style="-fx-background-color: #f5e6ca;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.coffeepos.renespresso.controller.LoginController">
    <children>
        <HBox alignment="CENTER" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>

                <!-- Left Branding Container -->
                <VBox alignment="CENTER" prefWidth="350.0" spacing="12.0" style="-fx-background-color: #dcc7aa;" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
                    </padding>
                    <children>
                        <!-- Logo Text Placeholder -->
                        <Label style="-fx-font-size: 42px;" text="☕" />

                        <Label style="-fx-text-fill: #6f4e37;" text="Renespresso">
                            <font>
                                <Font name="System Bold" size="28.0" />
                            </font>
                        </Label>

                        <Label style="-fx-text-fill: #6f4e37;" text="COFFEE SHOP POS">
                            <font>
                                <Font size="11.0" />
                            </font>
                        </Label>

                        <Label style="-fx-text-fill: #6f4e37; -fx-opacity: 0.85;" text="Quick, secure, and brewed&#10;to perfection." textAlignment="CENTER">
                            <font>
                                <Font name="System Italic" size="13.0" />
                            </font>
                            <VBox.margin>
                                <Insets top="10.0" />
                            </VBox.margin>
                        </Label>
                    </children>
                </VBox>

                <!-- Right Form Container -->
                <VBox alignment="CENTER_LEFT" prefWidth="500.0" spacing="20.0" style="-fx-background-color: #fffdf7;" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets bottom="40.0" left="50.0" right="50.0" top="40.0" />
                    </padding>
                    <children>

                        <!-- Form Header -->
                        <VBox spacing="4.0">
                            <children>
                                <Label style="-fx-text-fill: #6f4e37;" text="Login Account">
                                    <font>
                                        <Font name="System Bold" size="26.0" />
                                    </font>
                                </Label>
                                <Label style="-fx-text-fill: #6f4e37; -fx-opacity: 0.75;" text="Please enter your details to login.">
                                    <font>
                                        <Font size="13.0" />
                                    </font>
                                </Label>
                            </children>
                            <VBox.margin>
                                <Insets bottom="6.0" />
                            </VBox.margin>
                        </VBox>

                        <!-- Input Fields -->
                        <VBox spacing="14.0">
                            <children>
                                <!-- Username Field -->
                                <VBox spacing="4.0">
                                    <children>
                                        <Label style="-fx-text-fill: #6f4e37;" text="USERNAME">
                                            <font>
                                                <Font name="System Bold" size="10.0" />
                                            </font>
                                        </Label>
                                        <TextField fx:id="usernameField" prefHeight="42.0" promptText="Enter your username" style="-fx-background-color: #fffdf7; -fx-border-color: #dcc7aa; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 0 12; -fx-text-fill: #6f4e37;" />
                                    </children>
                                </VBox>

                                <!-- Password Field -->
                                <VBox spacing="4.0">
                                    <children>
                                        <Label style="-fx-text-fill: #6f4e37;" text="PASSWORD">
                                            <font>
                                                <Font name="System Bold" size="10.0" />
                                            </font>
                                        </Label>
                                        <PasswordField fx:id="passwordField" prefHeight="42.0" promptText="Enter your password" style="-fx-background-color: #fffdf7; -fx-border-color: #dcc7aa; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 0 12; -fx-text-fill: #6f4e37;" />
                                    </children>
                                </VBox>

                                <!-- Forgot Password Link -->
                                <HBox alignment="CENTER_RIGHT">
                                    <children>
                                        <Hyperlink fx:id="forgotPasswordLink" style="-fx-text-fill: #6f4e37; -fx-underline: false; -fx-opacity: 0.85;" text="Forgot Password?">
                                            <font>
                                                <Font size="11.0" />
                                            </font>
                                        </Hyperlink>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- Action Buttons & Navigation -->
                        <VBox alignment="CENTER" spacing="12.0">
                            <children>
                                <Button fx:id="loginButton" maxWidth="1.7976931348623157E308" prefHeight="44.0" style="-fx-background-color: #6f4e37; -fx-background-radius: 8px; -fx-text-fill: #fffdf7; -fx-cursor: hand;" text="Login">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Button>

                                <HBox alignment="CENTER" spacing="4.0">
                                    <children>
                                        <Label style="-fx-text-fill: #6f4e37; -fx-opacity: 0.8;" text="Don't have an account?">
                                            <font>
                                                <Font size="12.0" />
                                            </font>
                                        </Label>
                                        <Hyperlink fx:id="registerLink" style="-fx-text-fill: #6f4e37; -fx-underline: false;" text="Register">
                                            <font>
                                                <Font name="System Bold" size="12.0" />
                                            </font>
                                        </Hyperlink>
                                    </children>
                                </HBox>
                            </children>
                            <VBox.margin>
                                <Insets top="6.0" />
                            </VBox.margin>
                        </VBox>

                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</AnchorPane>