<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox minHeight="550.0" minWidth="750.0" prefHeight="650.0" prefWidth="950.0" style="-fx-background-color: #fffdf7;" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <!-- Left Branding Panel with Warm Cream Background -->
      <VBox alignment="CENTER" maxWidth="400.0" minWidth="280.0" prefWidth="360.0" spacing="18.0" styleClass="brand-panel" HBox.hgrow="SOMETIMES">
         <padding>
            <Insets bottom="40.0" left="36.0" right="36.0" top="40.0" />
         </padding>
         <children>
            <VBox VBox.vgrow="ALWAYS" />
            
            <!-- Coffee Icon Badge -->
            <VBox alignment="CENTER" maxHeight="80.0" maxWidth="80.0" minHeight="80.0" minWidth="80.0" styleClass="logo-badge">
               <children>
                  <Label style="-fx-font-size: 38px;" text="☕" />
               </children>
            </VBox>
            
            <Label styleClass="brand-title" text="Renespresso" textAlignment="CENTER" wrapText="true" />
            <Label styleClass="brand-subtitle" text="COFFEE SHOP POS" textAlignment="CENTER" />
            
            <VBox alignment="CENTER" spacing="4.0">
               <children>
                  <Label styleClass="brand-tagline" text="Quick, secure, and brewed" textAlignment="CENTER" wrapText="true" />
                  <Label styleClass="brand-tagline" text="to perfection." textAlignment="CENTER" wrapText="true" />
               </children>
               <VBox.margin>
                  <Insets top="8.0" />
               </VBox.margin>
            </VBox>

            <VBox VBox.vgrow="ALWAYS" />
         </children>
      </VBox>

      <!-- Right Form Panel -->
      <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
         <padding>
            <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
         </padding>
         <children>
            <!-- Form Card Wrapper for smooth visual hierarchy -->
            <VBox alignment="CENTER_LEFT" maxWidth="440.0" minWidth="300.0" spacing="28.0" styleClass="form-card" VBox.vgrow="NEVER">
               <padding>
                  <Insets bottom="36.0" left="36.0" right="36.0" top="36.0" />
               </padding>
               <children>
                  <!-- Header Text -->
                  <VBox spacing="8.0">
                     <children>
                        <Label styleClass="form-title" text="Forgot Password?" wrapText="true" />
                        <Label styleClass="form-description" text="Enter your registered email address below. We'll send you instructions to reset your password." wrapText="true" />
                     </children>
                  </VBox>

                  <!-- Form Inputs -->
                  <VBox spacing="20.0">
                     <children>
                        <VBox spacing="8.0">
                           <children>
                              <Label styleClass="input-label" text="EMAIL ADDRESS" />
                              <TextField fx:id="emailField" maxWidth="1.7976931348623157E308" prefHeight="46.0" promptText="barista@renespresso.com" styleClass="text-field" />
                           </children>
                        </VBox>

                        <!-- Rounded Reset Button -->
                        <Button fx:id="resetButton" maxWidth="1.7976931348623157E308" prefHeight="48.0" styleClass="button" text="Send Reset Link" />
                     </children>
                  </VBox>

                  <!-- Back to Login Link -->
                  <HBox alignment="CENTER" spacing="6.0">
                     <children>
                        <Label styleClass="footer-text" text="Remember your password?" />
                        <Hyperlink fx:id="loginLink" styleClass="hyperlink" text="Back to Login" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</HBox>