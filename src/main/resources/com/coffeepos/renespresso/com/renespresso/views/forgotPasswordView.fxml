<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox minHeight="500.0" minWidth="700.0" prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #fffdf7;" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <!-- Left Branding Panel -->
      <VBox alignment="CENTER" maxWidth="380.0" minWidth="260.0" prefWidth="340.0" spacing="16.0" style="-fx-background-color: #f5e6ca;" HBox.hgrow="SOMETIMES">
         <padding>
            <Insets bottom="40.0" left="30.0" right="30.0" top="40.0" />
         </padding>
         <children>
            <VBox VBox.vgrow="ALWAYS" />
            
            <Label style="-fx-font-size: 52px;" text="☕" />
            <Label style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #6f4e37;" text="Renespresso" textAlignment="CENTER" wrapText="true" />
            <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #6f4e37; -fx-character-spacing: 2px;" text="COFFEE SHOP POS" textAlignment="CENTER" />
            
            <VBox alignment="CENTER" spacing="4.0">
               <children>
                  <Label style="-fx-font-size: 13px; -fx-text-fill: #6f4e37; -fx-font-style: italic;" text="Quick, secure, and brewed" textAlignment="CENTER" wrapText="true" />
                  <Label style="-fx-font-size: 13px; -fx-text-fill: #6f4e37; -fx-font-style: italic;" text="to perfection." textAlignment="CENTER" wrapText="true" />
               </children>
               <VBox.margin>
                  <Insets top="12.0" />
               </VBox.margin>
            </VBox>

            <VBox VBox.vgrow="ALWAYS" />
         </children>
      </VBox>

      <!-- Right Form Panel -->
      <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
         <padding>
            <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
         </padding>
         <children>
            <VBox alignment="CENTER_LEFT" maxWidth="420.0" minWidth="280.0" spacing="24.0" VBox.vgrow="NEVER">
               <children>
                  <VBox spacing="8.0">
                     <children>
                        <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #6f4e37;" text="Forgot Password?" wrapText="true" />
                        <Label style="-fx-font-size: 13px; -fx-text-fill: #6f4e37;" text="Enter your registered email address below. We'll send you instructions to reset your password." wrapText="true" />
                     </children>
                  </VBox>

                  <VBox spacing="18.0">
                     <children>
                        <VBox spacing="6.0">
                           <children>
                              <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #6f4e37;" text="EMAIL ADDRESS" />
                              <TextField fx:id="emailField" maxWidth="1.7976931348623157E308" prefHeight="42.0" promptText="barista@renespresso.com" styleClass="text-field" />
                           </children>
                        </VBox>

                        <Button fx:id="resetButton" maxWidth="1.7976931348623157E308" prefHeight="44.0" styleClass="button" text="Send Reset Link" />
                     </children>
                  </VBox>

                  <HBox alignment="CENTER" spacing="6.0">
                     <children>
                        <Label style="-fx-font-size: 13px; -fx-text-fill: #6f4e37;" text="Remember your password?" />
                        <Hyperlink fx:id="loginLink" styleClass="hyperlink" text="Back to Login" />
                     </children>
                     <VBox.margin>
                        <Insets top="10.0" />
                     </VBox.margin>
                  </HBox>
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</HBox>